# ===== ADHD 后端部署环境变量模板 =====
# 用法： cp .env.production.example .env   （deploy/.env 会被 git 忽略，勿提交）
# 说明： docker-compose.yml 会读取 deploy/.env 里的同名变量。

# 答辩演示请保持 development，seed_demo_data 才能播种演示账号。
# 改成 production 后会要求强 SECRET_KEY、非占位数据库口令及可用加密密钥，且跳过演示播种。
APP_ENV=development

# 请改成随机强口令，例如：openssl rand -hex 24
SECRET_KEY=change-me-demo-2026

# AES-GCM 主密钥：base64url 编码的32字节随机值，不得提交或打印。
# development 留空时生成下方文件；production 需提供此变量或已存在的密钥文件。
DATA_ENCRYPTION_KEY=
SECURITY_MASTER_KEY_PATH=/app/backend/.keys/data_encryption.key

# 此镜像仅用于演示，显式使用 Mock；真实推理须配置依赖/权重并设 false。
USE_MOCK_MODEL=true

# MySQL（compose 由这几项拼出 DATABASE_URL；口令勿含 @ : / ? # [ ] 等 URL 保留字符）
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DB=adhd_demo
MYSQL_USER=adhd
MYSQL_PASSWORD=change-me-demo

# 宿主上暴露的 API 端口（默认绑定 127.0.0.1）
API_PORT=8000
# API 仅绑定宿主回环，信任 nginx 通过 Docker 网关的转发头。
# 改为公网直连或加入不可信容器时，须改成实际可信代理 IP 列表。
FORWARDED_ALLOW_IPS=*

# 浏览器跨域（doctor-web 与 API 同源时留空即可；仅当把前端单独部署到别的域名才填，逗号分隔）
BACKEND_CORS_ORIGINS=

# AI 能力（可选，留空则走模板降级，不影响演示）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REMINDER_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=300

# 上传
UPLOAD_MAX_BYTES=10485760
# 影像可视化 NIfTI/GIfTI multipart 请求总上限（64 MiB，含表单开销）。
FINDVIZ_MAX_UPLOAD_BYTES=536870912

# 时区
TZ=Asia/Shanghai
