PROJECT_NAME=ADHD Assist Platform API
API_V1_STR=/api/v1
SECRET_KEY=change-this-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite quick start:
# DATABASE_URL=sqlite:///./backend/app.db
DATABASE_URL=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=adhd_demo

BACKEND_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# Qwen / DashScope
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_CHAT_MODEL=qwen-plus-latest
QWEN_REMINDER_MODEL=qwen-flash
QWEN_TIMEOUT_SECONDS=60
