# Development-only example. Copy to backend/.env and replace placeholders.
APP_ENV=development
PROJECT_NAME=ADHD Assist Platform API
API_V1_STR=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite quick start. Use an absolute URL or MySQL settings for deployment.
DATABASE_URL=sqlite:///./backend/app.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=adhd_demo

BACKEND_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Optional AI provider. Leave blank when the AI provider is not configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REMINDER_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=300

# Model and upload settings. Real and Mock inference share one route, selected by mode.
UPLOAD_ROOT=backend/uploads
UPLOAD_MAX_BYTES=10485760
# 影像可视化 NIfTI/GIfTI multipart 请求总上限（64 MiB，含表单开销）。
FINDVIZ_MAX_UPLOAD_BYTES=536870912

# Inference mode (backend/app/core/config.py -> USE_MOCK_MODEL):
#   blank / false / strict -> real HGST inference (missing deps/weights returns 503; no silent degrade) [default]
#   true                  -> always the demo Mock ("real upload, fake result", is_demo=true; for defense/demo)
#   auto                  -> real first; auto-fall back to a labeled Mock (warning log) when real HGST is unavailable
USE_MOCK_MODEL=

# HGST real-inference paths. Leave BLANK to use the built-in defaults:
#   HGST_PRETRAINED_WEIGHTS_PATH      default: <repo>/HGST-main/logs/ADHD/sparse_2026-04-01-11-41-03/pretrained_model_2020.pth
#   HGST_DEPLOYMENT_BUNDLE_PATH       default: <repo>/backend/models/hgst_adhd_bundle.pt
HGST_PRETRAINED_WEIGHTS_PATH=
HGST_DEPLOYMENT_BUNDLE_PATH=
HGST_DEFAULT_DATA_DIR=
HGST_DEFAULT_LABELS_PATH=
# Retain only the original byte-pinned HGST bundle (owner decision 2026-10-18).
# Not a training provenance, input-equivalence or clinical validation claim.
HGST_LEGACY_COMPATIBILITY_ENABLED=true
# Blank uses the existing project-local Python 3.10 compatibility interpreter.
HGST_INFERENCE_PYTHON=

# Independent AES-GCM master key: base64url of 32 random bytes; required in production.
DATA_ENCRYPTION_KEY=
# Development generates this file once. Keep it outside database backups.
SECURITY_MASTER_KEY_PATH=backend/.keys/data_encryption.key

# Independent authorization ledger. Set an absolute path outside business-database backups.
# Leave blank until separately provisioned; missing or inconsistent authority fails closed.
# Application startup does not provision this ledger or migrate a real business database.
AUTHORIZATION_LEDGER_PATH=

# Enable the care outbox worker only after the explicit W05 schema is ready.
# Tests use temporary databases. No live migration or external notification occurs.
CARE_WORKER_ENABLED=false
CARE_WORKER_INTERVAL_SECONDS=1
CARE_WORKER_LEASE_SECONDS=30

# Unified Agent: positive per-run token/cost caps and actual deployment prices
# are required for external model dispatch. Units are one-millionth of the
# deployment's configured billing currency; no price or currency is inferred.
AGENT_MAX_PROMPT_TOKENS=0
AGENT_MAX_COMPLETION_TOKENS=0
AGENT_MAX_COST_MICROUNITS=0
AGENT_PROMPT_MICROUNITS_PER_TOKEN=
AGENT_COMPLETION_MICROUNITS_PER_TOKEN=
# Local bounded Flash example (USD microunits, verify current pricing first):
# AGENT_MAX_PROMPT_TOKENS=30000; AGENT_MAX_COMPLETION_TOKENS=1500
# AGENT_MAX_COST_MICROUNITS=10000 (USD 0.01 per run)
# AGENT_PROMPT_MICROUNITS_PER_TOKEN=0.3; AGENT_COMPLETION_MICROUNITS_PER_TOKEN=1.2
# https://api-docs.deepseek.com/quick_start/pricing/ (checked 2026-10-17)
# Enable only after the explicit Agent schema has been reviewed and prepared.
# POST scheduling still works when this recovery scanner is disabled.
AGENT_WORKER_ENABLED=false
AGENT_WORKER_INTERVAL_SECONDS=2

# Model registry stays disabled until provenance and deployment readiness have
# been reviewed. Instance keys belong in deployment secrets, never in this file.
MODEL_REGISTRY_ENABLED=false
MODEL_REGISTRY_ARTIFACT_ROOT=
MODEL_REGISTRY_REQUIRED_INSTANCES=
MODEL_REGISTRY_INSTANCE_KEYS_JSON={}

# Optional WeChat reminders. Values must belong to the same mini program.
# Runtime never provisions real tables or sends without explicit configuration.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SUBSCRIBE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_TITLE_FIELD=
WECHAT_SUBSCRIBE_TIME_FIELD=
WECHAT_NOTIFICATION_SEND_ENABLED=false
WECHAT_NOTIFICATION_WORKER_ENABLED=false
WECHAT_MINIPROGRAM_STATE=formal
