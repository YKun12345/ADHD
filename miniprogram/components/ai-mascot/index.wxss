:host {
  width: 100%;
  height: 100%;
  display: block;
}

.ai-mascot {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: 50% 82%;
  animation: mascotBreathe 7200ms ease-in-out infinite;
}

.ai-mascot__ear {
  position: absolute;
  top: 5%;
  width: 34%;
  height: 38%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 68% 32% 58% 42%;
  box-sizing: border-box;
  background: linear-gradient(145deg, #efb078, #d87559);
}

.ai-mascot__ear--left {
  left: 7%;
  transform: rotate(-19deg);
}

.ai-mascot__ear--right {
  right: 7%;
  transform: scaleX(-1) rotate(-19deg);
}

.ai-mascot__face {
  position: absolute;
  right: 5%;
  bottom: 3%;
  left: 5%;
  height: 79%;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 46% 46% 42% 42%;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 34% 26%, rgba(255, 255, 255, 0.54) 0, rgba(255, 255, 255, 0) 24%),
    linear-gradient(145deg, #fff1d8 0%, #efbd87 56%, #df8f67 100%);
  box-shadow: inset 0 -8rpx 16rpx rgba(23, 79, 93, 0.12);
}

.ai-mascot__eye {
  position: absolute;
  top: 43%;
  width: 10%;
  height: 13%;
  border-radius: 50%;
  background: #173f50;
  transition: transform 160ms ease;
}

.ai-mascot__eye--left { left: 27%; }
.ai-mascot__eye--right { right: 27%; }

.ai-mascot__cheek {
  position: absolute;
  top: 60%;
  width: 15%;
  height: 9%;
  border-radius: 50%;
  background: rgba(255, 199, 187, 0.66);
}

.ai-mascot__cheek--left { left: 15%; }
.ai-mascot__cheek--right { right: 15%; }

.ai-mascot__nose {
  position: absolute;
  top: 57%;
  left: 47%;
  width: 6%;
  height: 5%;
  border-radius: 50%;
  background: #24586a;
}

.ai-mascot__mouth {
  position: absolute;
  top: 66%;
  left: 42%;
  width: 16%;
  height: 9%;
  box-sizing: border-box;
  border-bottom: 3rpx solid #24586a;
  border-radius: 0 0 999rpx 999rpx;
}

.ai-mascot__spark {
  position: absolute;
  top: 13%;
  left: 43%;
  width: 15%;
  height: 15%;
  animation: mascotSpark 9000ms ease-in-out infinite;
}

.ai-mascot__coat {
  position: absolute;
  right: 14%;
  bottom: 0;
  left: 14%;
  height: 31%;
  overflow: hidden;
  border-radius: 46% 46% 24% 24%;
  background: #fffaf0;
  box-shadow: inset 0 -4rpx 8rpx rgba(122, 90, 80, 0.08);
}

.ai-mascot__stethoscope {
  position: absolute;
  top: -8%;
  width: 34%;
  height: 62%;
  border-bottom: 4rpx solid #54a99a;
}
.ai-mascot__stethoscope--left { left: 15%; border-left: 4rpx solid #54a99a; border-radius: 0 0 0 60%; }
.ai-mascot__stethoscope--right { right: 15%; border-right: 4rpx solid #54a99a; border-radius: 0 0 60% 0; }
.ai-mascot__badge { position: absolute; top: 25%; left: 43%; width: 18%; height: 42%; border-radius: 30% 30% 44% 44%; background: #ffd88c; transform: rotate(45deg); }
.ai-mascot__badge-wave { position: absolute; top: 46%; left: 15%; width: 70%; height: 3rpx; background: #27758a; transform: rotate(-45deg); }
.ai-mascot__arm { position: absolute; z-index: 2; bottom: 3%; width: 20%; height: 28%; border-radius: 999rpx; background: #fffaf0; transform-origin: 50% 90%; }
.ai-mascot__arm--left { left: 4%; transform: rotate(22deg); }
.ai-mascot__arm--right { right: 4%; transform: rotate(-22deg); }

.ai-mascot__spark-line {
  position: absolute;
  top: 45%;
  left: 0;
  width: 100%;
  height: 10%;
  border-radius: 999rpx;
  background: #fff5bf;
}

.ai-mascot__spark-line--vertical { transform: rotate(90deg); }
.ai-mascot__spark-line--horizontal { transform: rotate(0); }

.ai-mascot--idle .ai-mascot__face { background-color: #efbd87; }
.ai-mascot--idle.ai-mascot--interactive { animation: mascotIdleSway 8s ease-in-out infinite; }
.ai-mascot--idle.ai-mascot--interactive .ai-mascot__eye { animation: mascotIdleBlink 5.4s ease-in-out infinite; }
.ai-mascot--idle.ai-mascot--interactive .ai-mascot__arm--right { animation: mascotIdleWave 14s ease-in-out infinite; }

.ai-mascot--happy .ai-mascot__eye {
  height: 8%;
  border-radius: 999rpx 999rpx 40% 40%;
  transform: translateY(3rpx) rotate(2deg);
}

.ai-mascot--happy .ai-mascot__mouth {
  height: 12%;
  border-bottom-width: 5rpx;
}

.ai-mascot--thinking .ai-mascot__spark {
  animation-duration: 900ms;
}

.ai-mascot--thinking .ai-mascot__eye--right {
  height: 4%;
  border-radius: 999rpx;
  transform: translateY(4rpx);
}

.ai-mascot--wave .ai-mascot__arm--right { animation: mascotWave 900ms ease-in-out 2; }
.ai-mascot--wave .ai-mascot__mouth,
.ai-mascot--guide .ai-mascot__mouth { height: 12%; border-bottom-width: 5rpx; }
.ai-mascot--listening .ai-mascot__ear--left { transform: rotate(-27deg); }
.ai-mascot--listening .ai-mascot__ear--right { transform: scaleX(-1) rotate(-27deg); }
.ai-mascot--guide .ai-mascot__badge { background: #ffca70; }
.ai-mascot--care .ai-mascot__eye { height: 9%; transform: translateY(2rpx); }
.ai-mascot--care .ai-mascot__cheek { opacity: 0.82; }

.ai-mascot--waiting .ai-mascot__face { transform: rotate(-3deg); }
.ai-mascot--waiting .ai-mascot__spark { animation-duration: 6000ms; }
.ai-mascot--success { animation: mascotSuccess 1200ms ease-in-out 1; }
.ai-mascot--success .ai-mascot__eye { transform: scaleY(0.62); }
.ai-mascot--success .ai-mascot__arm--right { transform: translateY(-12%) rotate(-48deg); }
.ai-mascot--recover { animation: mascotRecover 1000ms ease-in-out 1; }
.ai-mascot--recover .ai-mascot__face { transform: rotate(-4deg); }
.ai-mascot--recover .ai-mascot__cheek { opacity: 0.82; }
.ai-mascot--sleep { animation: none; }
.ai-mascot--sleep .ai-mascot__eye { transform: translateY(3rpx) scaleY(0.18); }
.ai-mascot--sleep .ai-mascot__spark { opacity: 0.35; animation: none; }

.ai-mascot--idle.ai-mascot--react-blink .ai-mascot__eye { transform: scaleY(0.12); animation: mascotBlink 900ms ease-in-out 1; }
.ai-mascot--interactive.ai-mascot--react-tilt { transform: rotate(14deg); animation: mascotTilt 1500ms ease-in-out 1; }
.ai-mascot--idle.ai-mascot--react-wave .ai-mascot__arm--right { transform: translateY(-28%) rotate(-128deg); animation: mascotWave 900ms ease-in-out 2; }

.ai-mascot--paused,
.ai-mascot--paused .ai-mascot__face,
.ai-mascot--paused .ai-mascot__spark,
.ai-mascot--paused .ai-mascot__eye,
.ai-mascot--paused .ai-mascot__arm {
  animation: none !important;
  transition: none !important;
}

@keyframes mascotWave {
  0%, 100% { transform: rotate(-22deg); }
  35%, 65% { transform: translateY(-28%) rotate(-128deg); }
  50% { transform: translateY(-22%) rotate(-95deg); }
}

@keyframes mascotIdleSway {
  0%, 75%, 100% { transform: translateY(0) rotate(0); }
  20% { transform: translateY(-4%) rotate(-5deg); }
  40% { transform: translateY(0) rotate(3deg); }
  60% { transform: translateY(-3%) rotate(0); }
}

@keyframes mascotIdleBlink {
  0%, 12%, 20%, 68%, 76%, 100% { transform: scaleY(1); }
  15%, 72% { transform: scaleY(0.12); }
}

@keyframes mascotIdleWave {
  0%, 18%, 38%, 100% { transform: rotate(-22deg); }
  22%, 30% { transform: translateY(-28%) rotate(-118deg); }
  26%, 34% { transform: translateY(-22%) rotate(-82deg); }
}

@keyframes mascotBreathe {
  0%, 70%, 100% { transform: translateY(0) scale(1); }
  85% { transform: translateY(-1.5%) scale(1.015); }
}

@keyframes mascotSpark {
  0%, 70%, 100% { opacity: 0.68; transform: rotate(0deg) scale(0.94); }
  85% { opacity: 0.9; transform: rotate(12deg) scale(1.02); }
}

@keyframes mascotBlink {
  0%, 100% { transform: scaleY(1); }
  30%, 60% { transform: scaleY(0.12); }
}

@keyframes mascotTilt {
  0%, 100% { transform: rotate(0deg); }
  35%, 65% { transform: rotate(14deg); }
}

@keyframes mascotSuccess {
  0%, 100% { transform: translateY(0) scale(1); }
  35% { transform: translateY(-12%) scale(1.06); }
  65% { transform: translateY(-4%) scale(1.02); }
}

@keyframes mascotRecover {
  0%, 100% { transform: rotate(0deg); }
  40% { transform: rotate(-3deg); }
  70% { transform: rotate(2deg); }
}

@media (prefers-reduced-motion: reduce) {
  .ai-mascot,
  .ai-mascot .ai-mascot__face,
  .ai-mascot .ai-mascot__spark,
  .ai-mascot .ai-mascot__eye,
  .ai-mascot .ai-mascot__arm {
    animation: none !important;
    transition: none !important;
  }
}

/* Three aligned frames preserve the approved golden puppy identity. */
.ai-mascot__sprite-viewport { position:relative;width:100%;height:100%;overflow:hidden; }
.ai-mascot__fallback { position:relative;width:100%;height:100%; }
.ai-mascot__sprite-sheet { display:block;width:300%;max-width:none;height:100%;transform:translateX(0);pointer-events:none; }
.ai-mascot--idle .ai-mascot__sprite-sheet { animation:mascotSpriteIdle 12s steps(1,end) infinite; }
.ai-mascot--wave .ai-mascot__sprite-sheet,.ai-mascot--guide .ai-mascot__sprite-sheet { transform:translateX(-66.666667%); }
.ai-mascot--happy .ai-mascot__sprite-sheet,.ai-mascot--sleep .ai-mascot__sprite-sheet { transform:translateX(-33.333333%); }
.ai-mascot--listening .ai-mascot__sprite-viewport { transform:rotate(-5deg); }
.ai-mascot--thinking .ai-mascot__sprite-viewport { transform:rotate(5deg); }
.ai-mascot--waiting .ai-mascot__sprite-viewport { transform:rotate(-3deg); }
.ai-mascot--success .ai-mascot__sprite-sheet { transform:translateX(-66.666667%); }
.ai-mascot--idle.ai-mascot--react-blink .ai-mascot__sprite-sheet { animation:mascotSpriteBlink 900ms steps(1,end) 1; }
.ai-mascot--idle.ai-mascot--react-wave .ai-mascot__sprite-sheet { animation:mascotSpriteWave 1800ms steps(1,end) 1; }
.ai-mascot--paused .ai-mascot__sprite-sheet { animation:none !important; }
@keyframes mascotSpriteIdle {
  0%,10%,15%,58%,65%,71%,77%,100% { transform:translateX(0); }
  12%,13% { transform:translateX(-33.333333%); }
  61%,68%,74% { transform:translateX(-66.666667%); }
}
@keyframes mascotSpriteBlink {
  0%,70%,100% { transform:translateX(0); }
  25%,50% { transform:translateX(-33.333333%); }
}
@keyframes mascotSpriteWave {
  0%,25%,55%,85%,100% { transform:translateX(0); }
  10%,40%,70% { transform:translateX(-66.666667%); }
}
@media (prefers-reduced-motion: reduce) {
  .ai-mascot .ai-mascot__sprite-sheet { animation:none !important; }
}
