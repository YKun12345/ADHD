.authorization-panel { margin-top: 24rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; color: #263e5d; }
.panel-title, .panel-heading, .panel-note, .panel-error { display: block; }
.panel-title { font-size: 30rpx; font-weight: 700; }
.panel-heading { margin-top: 24rpx; font-size: 26rpx; font-weight: 650; }
.panel-note { margin-top: 12rpx; font-size: 23rpx; color: #62748a; line-height: 1.7; overflow-wrap: anywhere; }
.panel-error { margin: 14rpx 0; color: #b33d3d; font-size: 23rpx; }
.authorization-row { border-bottom: 1rpx solid #e0e8ef; padding: 20rpx 0; }
.panel-input { height: 88rpx; margin-top: 16rpx; padding: 0 18rpx; background: #f2f6f9; border-radius: 16rpx; font-size: 24rpx; }
.panel-button { margin-top: 16rpx; font-size: 24rpx; background: #e5eef7; color: #315f91; min-height: 88rpx; border-radius: 16rpx; }
.panel-button::after { border: 0; }
.scope-options { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 16rpx; font-size: 23rpx; }
