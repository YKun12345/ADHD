:host{display:block}.data-preview{box-sizing:border-box;position:relative;display:flex;align-items:center;justify-content:center;color:var(--ui-primary,#159ca8);font-size:30rpx;font-weight:600}.data-preview--ring{width:106rpx;height:106rpx;border:9rpx solid #dcecf3;border-radius:50%}.data-preview--inverse{border-color:rgba(255,255,255,.25);color:#fff}.data-preview--chart{height:172rpx;width:100%;background:#f3f9fd;border-radius:22rpx}.data-preview__axes{position:absolute;left:30rpx;right:24rpx;top:26rpx;bottom:26rpx;border-left:1rpx solid #cbdde8;border-bottom:1rpx dashed #cbdde8}
