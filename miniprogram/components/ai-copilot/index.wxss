.ai-copilot {
  position: fixed;
  z-index: 1200;
  width: 104rpx;
  height: 104rpx;
}

.ai-copilot__panel {
  position: fixed;
  right: 24rpx;
  bottom: 32rpx;
  bottom: calc(32rpx + constant(safe-area-inset-bottom));
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  max-height: calc(100vh - 240rpx);
  overflow-y: auto;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--ui-line, #e7eef3);
  border-radius: var(--ui-radius-lg, 32rpx);
  color: var(--ui-ink, #183747);
  background: #ffffff;
  box-shadow: var(--ui-shadow-soft, 0 8rpx 28rpx rgba(35, 80, 105, 0.06));
}

.ai-copilot__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-copilot__guide-bubble {
  position: absolute;
  width: 480rpx;
  box-sizing: border-box;
  padding: 22rpx 52rpx 22rpx 24rpx;
  border: 1rpx solid var(--ui-line, #e7eef3);
  border-radius: 24rpx 24rpx 6rpx 24rpx;
  background: #fffaf2;
  color: var(--ui-ink, #183747);
  box-shadow: var(--ui-shadow-soft, 0 8rpx 28rpx rgba(35, 80, 105, 0.06));
}

.ai-copilot--left .ai-copilot__guide-bubble {
  left: 0;
}

.ai-copilot--right .ai-copilot__guide-bubble {
  right: 0;
}

.ai-copilot--above .ai-copilot__guide-bubble {
  bottom: 116rpx;
}

.ai-copilot--below .ai-copilot__guide-bubble {
  top: 116rpx;
}

.ai-copilot__guide-text { font-size: 26rpx; line-height: 1.55; }
.ai-copilot__greeting { display: block; margin-bottom: 6rpx; font-size: 26rpx; font-weight: 650; }
.ai-copilot__guide-close { position: absolute; top: 10rpx; right: 14rpx; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; color: #6b7f88; font-size: 34rpx; }

.ai-copilot__partner {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.ai-copilot__partner-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
}

.ai-copilot__partner-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
}

.ai-copilot__companion-name {
  color: var(--ui-primary, #159ca8);
  font-size: 21rpx;
  font-weight: 700;
}

.ai-copilot__title {
  color: var(--ui-ink, #183747);
  font-size: 29rpx;
  font-weight: 700;
}

.ai-copilot__close {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(199, 221, 227, 0.82);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  transition: opacity 140ms ease, transform 140ms ease;
}

.ai-copilot__close-line {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #506b75;
}

.ai-copilot__close-line--a {
  transform: rotate(45deg);
}

.ai-copilot__close-line--b {
  transform: rotate(-45deg);
}

.ai-copilot__advice,
.ai-copilot__companion-line,
.ai-copilot__notice {
  display: block;
}

.ai-copilot__companion-line {
  margin-top: 10rpx;
  color: var(--ui-primary, #159ca8);
  font-size: 21rpx;
  line-height: 1.55;
}

.ai-copilot__advice {
  margin-top: 16rpx;
  color: var(--ui-text, #607583);
  font-size: 23rpx;
  line-height: 1.65;
}

.ai-copilot__actions {
  display: flex;
  margin-top: 24rpx;
}

.ai-copilot__action + .ai-copilot__action {
  margin-left: 12rpx;
}

.ai-copilot__action {
  min-width: 0;
  min-height: 88rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  border-radius: 21rpx;
  font-size: 22rpx;
  font-weight: 650;
  transition: opacity 140ms ease, transform 140ms ease;
}

.ai-copilot__action--primary {
  color: #ffffff;
  background: var(--ui-primary, #159ca8);
  box-shadow: var(--ui-shadow-soft, 0 8rpx 28rpx rgba(35, 80, 105, 0.06));
}

.ai-copilot__action--secondary {
  border: 1rpx solid var(--ui-line, #e7eef3);
  color: var(--ui-primary, #159ca8);
  background: var(--ui-bg, #eaf4fc);
}

.ai-copilot__notice {
  margin-top: 17rpx;
  color: #5d747d;
  font-size: 21rpx;
  line-height: 1.55;
}

.ai-copilot__pet-reply {
  display: block;
  margin-top: 14rpx;
  color: var(--ui-ink, #183747);
  font-size: 24rpx;
  line-height: 1.55;
}

.ai-copilot__motion-control {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  color: var(--ui-primary, #159ca8);
  font-size: 22rpx;
}

.ai-copilot__control--pressed {
  opacity: 0.76;
  transform: scale(0.98);
}

.ai-copilot__trigger {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  background: transparent;
  box-shadow: none;
  transition: opacity 140ms ease, transform 140ms ease;
}

.ai-copilot__icon {
  position: relative;
  z-index: 1;
  width: 104rpx;
  height: 104rpx;
  transform:scale(1.25);
  transform-origin:70% 100%;
}

.ai-copilot__trigger--pressed {
  opacity: 0.84;
  transform: scale(0.96);
}

@media (prefers-reduced-motion: reduce) {
  .ai-copilot__close,
  .ai-copilot__action,
  .ai-copilot__trigger {
    transition: none;
  }

  .ai-copilot__control--pressed,
  .ai-copilot__trigger--pressed {
    transform: none;
  }
}
.ai-copilot__steps{max-height:42vh;overflow-y:auto;margin-top:20rpx;padding:18rpx 20rpx;border-radius:16rpx;background:#f1f8f7;box-sizing:border-box}
.ai-copilot__step{display:block;margin:0 0 14rpx;font-size:25rpx;line-height:1.7;color:#3f6d72;white-space:pre-wrap}
.ai-copilot__stay-note{display:block;font-size:21rpx;line-height:1.6;color:#7a9697}
