:host {
  display: block;
  position: sticky;
  top: 0;
  z-index: 40;
}

.ui-nav {
  box-sizing: border-box;
  width: 100%;
  background: #f7fbfe;
  border-bottom: 1rpx solid rgba(225,237,244,.6);
}

.ui-nav__bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
}

.ui-nav__title {
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 340rpx;
  max-width: calc(100% - 320rpx);
  overflow: hidden;
  color: var(--ui-ink,#183747);
  font-size: var(--ui-font-title,34rpx);
  font-weight: 650;
  line-height: 1.25;
  letter-spacing: 1rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  transform: translateX(-50%) translateY(-50%);
  pointer-events: none;
}

.ui-nav__action {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  min-width: 88rpx;
  width: 120rpx;
  height: 88rpx;
  box-sizing: border-box;
  color: #236b80;
  font-size: 28rpx;
  line-height: 1;
  flex: none;
}

.ui-nav__action--back {
  justify-content: flex-start;
}

.ui-nav__action--right {
  justify-content: flex-end;
  font-weight: 600;
}

.ui-nav__action--placeholder {
  visibility: hidden;
}

.ui-nav__action--pressed {
  opacity: 0.56;
  transform: scale(0.97);
}
