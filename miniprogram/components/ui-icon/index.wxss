  background: #3d927f;
  border-radius: 50%;
  transform: translateY(-50%);
}

.ui-icon--stroop .ui-icon__a {
  width: 48rpx;
  height: 44rpx;
  border: 3rpx solid currentColor;
  border-radius: 14rpx 22rpx 14rpx 22rpx;
  transform: translate(-50%, -50%) rotate(8deg);
}

.ui-icon--stroop .ui-icon__b {
  top: 20rpx;
  right: 19rpx;
  left: auto;
  width: 13rpx;
  height: 13rpx;
  background: #50bee0;
  border-radius: 4rpx;
  transform: rotate(30deg);
}

.ui-icon__letter {
  position: relative;
  z-index: 1;
  color: currentColor;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.ui-icon--report .ui-icon__a {
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid currentColor;
  border-radius: 11rpx;
  transform: translate(-50%, -50%) rotate(45deg);
}

.ui-icon--report .ui-icon__b {
  width: 18rpx;
  height: 18rpx;
  background: rgba(80, 190, 224, 0.18);
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ui-icon--tracking .ui-icon__a {
  width: 52rpx;
  height: 30rpx;
  border-bottom: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
