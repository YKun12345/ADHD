:host {
  display: inline-flex;
  flex: none;
  vertical-align: middle;
  pointer-events: none;
}

.ui-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #236b80;
  background: linear-gradient(145deg, #f8fdfe 0%, #e7f5f8 100%);
  border: 1rpx solid #d3e9ee;
}

.ui-icon--shape-orbit {
  border-radius: 50%;
  box-shadow: inset 0 0 0 11rpx rgba(80, 190, 224, 0.05);
}

.ui-icon--shape-sheet {
  border-radius: 26rpx 26rpx 10rpx 26rpx;
  box-shadow: 7rpx 7rpx 0 rgba(80, 190, 224, 0.07);
}

.ui-icon--shape-lens {
  color: #665bc7;
  background: linear-gradient(145deg, #faf9ff 0%, #ece9fb 100%);
  border-color: #dfdcf5;
  border-radius: 30rpx;
}

.ui-icon--shape-pill {
  width: 104rpx;
  color: #236b80;
  background: linear-gradient(90deg, #e5f5f1 0%, #e5f5f1 50%, #fff0ed 50%, #fff0ed 100%);
  border-radius: 999rpx;
}

.ui-icon--shape-book {
  color: #936128;
  background: linear-gradient(145deg, #fffaf2 0%, #f7ecd9 100%);
  border-color: #eadfcf;
  border-radius: 12rpx 28rpx 28rpx 28rpx;
}

.ui-icon--shape-orb {
  color: #ffffff;
  background: linear-gradient(145deg, #236b80 0%, #318ca6 58%, #50bee0 100%);
  border-color: rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  box-shadow: 0 8rpx 22rpx rgba(35, 107, 128, 0.18);
}

.ui-icon--shape-target,
.ui-icon--shape-path,
.ui-icon--shape-arrows,
.ui-icon--shape-grid,
.ui-icon--shape-digits {
  border-radius: 24rpx;
  background: linear-gradient(145deg, #f8fdfe 0%, #e7f5f8 100%);
}

.ui-icon--speed .ui-icon__a {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ui-icon--speed .ui-icon__b {
  width: 5rpx;
  height: 22rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(38deg);
  transform-origin: 50% 100%;
}

.ui-icon--trail .ui-icon__a {
  width: 52rpx;
  height: 30rpx;
  border-top: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: translate(-50%, -50%) rotate(-24deg);
}

.ui-icon--trail .ui-icon__b,
.ui-icon--trail .ui-icon__c {
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ui-icon--trail .ui-icon__b { left: 20rpx; }
.ui-icon--trail .ui-icon__c { left: 64rpx; }

.ui-icon--flanker .ui-icon__a,
.ui-icon--flanker .ui-icon__b,
.ui-icon--flanker .ui-icon__c {
  width: 18rpx;
  height: 18rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.ui-icon--flanker .ui-icon__a { left: 24rpx; }
.ui-icon--flanker .ui-icon__c { left: 60rpx; }

.ui-icon--nback .ui-icon__a {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid currentColor;
  background: linear-gradient(90deg, transparent 31%, currentColor 32%, currentColor 35%, transparent 36%, transparent 64%, currentColor 65%, currentColor 68%, transparent 69%), linear-gradient(transparent 31%, currentColor 32%, currentColor 35%, transparent 36%, transparent 64%, currentColor 65%, currentColor 68%, transparent 69%);
}

.ui-icon--nback .ui-icon__b {
  top: 23rpx;
  left: 23rpx;
  width: 12rpx;
  height: 12rpx;
  background: #3f8b7f;
  transform: none;
}

.ui-icon--digit .ui-icon__a {
  width: 48rpx;
  height: 38rpx;
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
}

.ui-icon--digit .ui-icon__b {
  width: 28rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor, 0 -10rpx 0 currentColor;
}

.ui-icon__a,
.ui-icon__b,
.ui-icon__c,
.ui-icon__d {
  position: absolute;
  top: 50%;
  left: 50%;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.ui-icon--plan .ui-icon__a {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ui-icon--plan .ui-icon__b {
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  border-radius: 50%;
}

.ui-icon--plan .ui-icon__c {
  top: 16rpx;
  right: 19rpx;
  left: auto;
  width: 8rpx;
  height: 8rpx;
  background: #50bee0;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  transform: none;
}

.ui-icon--scale .ui-icon__a {
  width: 38rpx;
  height: 50rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.ui-icon--scale .ui-icon__b {
  top: 28rpx;
  width: 20rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor, 0 20rpx 0 currentColor;
  transform: translateX(-50%);
}

.ui-icon--scale .ui-icon__c {
  top: 20rpx;
  left: 30rpx;
  width: 8rpx;
  height: 8rpx;
  background: #4aa997;
  border-radius: 50%;
  transform: none;
}

.ui-icon--cognitive .ui-icon__a,
.ui-icon--cognitive .ui-icon__b {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.ui-icon--cognitive .ui-icon__a {
  top: 20rpx;
  left: 16rpx;
  transform: none;
}

.ui-icon--cognitive .ui-icon__b {
  right: 16rpx;
  bottom: 20rpx;
  top: auto;
  left: auto;
  color: #318ca6;
  transform: none;
}

.ui-icon--cognitive .ui-icon__c {
  width: 14rpx;
  height: 3rpx;
  background: #50bee0;
  transform: translate(-50%, -50%) rotate(-42deg);
}

.ui-icon--gonogo .ui-icon__a {
  left: 18rpx;
  width: 25rpx;
  height: 25rpx;
  border: 3rpx solid #3d927f;
  border-radius: 50%;
