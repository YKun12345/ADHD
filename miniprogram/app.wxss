/** app.wxss **/
page {
  --ui-ink: #173f50;
  --ui-text: #506b75;
  --ui-muted: #5d747d;
  --ui-bg: #f2f8fa;
  --ui-surface: rgba(255,255,255,0.78);
  --ui-line: #d7e7eb;
  --ui-primary: #236b80;
  --ui-highlight: #50bee0;
  --ui-cognitive: #7367d9;
  --ui-success: #4aa997;
  --ui-warning: #e0a45b;
  --ui-danger: #e06f67;

  min-height: 100%;
  color: var(--ui-ink);
  background-color: var(--ui-bg);
  background-image:
    radial-gradient(circle at 12% 0%, rgba(80, 190, 224, 0.14) 0, rgba(80, 190, 224, 0) 38%),
    radial-gradient(circle at 100% 24%, rgba(115, 103, 217, 0.07) 0, rgba(115, 103, 217, 0) 34%),
    linear-gradient(160deg, #f8fcfd 0%, var(--ui-bg) 58%, #edf6f8 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
}

.ui-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 56rpx;
  padding: 32rpx 32rpx calc(56rpx + constant(safe-area-inset-bottom));
  padding: 32rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.ui-card,
.glass-surface {
  position: relative;
  box-sizing: border-box;
  background: var(--ui-surface);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(60, 104, 119, 0.09);
}

.glass-surface {
  overflow: hidden;
}

.glass-surface::before {
  content: "";
  position: absolute;
  top: 0;
  right: 24rpx;
  left: 24rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.ui-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 32rpx;
  color: var(--ui-ink);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(215, 231, 235, 0.92);
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  transition: transform 140ms ease, opacity 140ms ease;
}

.ui-button::after {
  border: 0;
}

.ui-button--primary {
  color: #ffffff;
  background: linear-gradient(135deg, #236b80 0%, #27758a 100%);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(49, 140, 166, 0.18);
}

.ui-button--secondary {
  color: #236b80;
  background: rgba(225, 243, 248, 0.86);
  border-color: rgba(168, 210, 220, 0.74);
}

.ui-button--pressed,
.ui-clickable--pressed {
  opacity: 0.88;
  transform: scale(.985);
}

.ui-button--disabled {
  color: rgba(102, 128, 138, 0.66);
  background: rgba(225, 234, 237, 0.72);
  border-color: rgba(215, 231, 235, 0.74);
  box-shadow: none;
  opacity: 0.62;
  transform: none;
}

.ui-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  color: var(--ui-ink);
  background: rgba(255, 255, 255, 0.68);
  border: 1rpx solid var(--ui-line);
  border-radius: 24rpx;
  font-size: 27rpx;
}

.ai-copilot-safe-space.ai-copilot-safe-space {
  padding-bottom: 196rpx;
  padding-bottom: calc(196rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

@media (prefers-reduced-motion: reduce) {
  .ui-button,
  .ui-pressable {
    transition: none;
  }

  .ui-button--pressed,
  .ui-clickable--pressed,
  .ui-pressable--pressed {
    transform: none;
  }
}
