<ai-copilot page-key="scale" />
<ui-nav title="{{title}}" />
<view class="scale-page ai-copilot-safe-space">
  <view class="scale-header">
    <view class="scale-hero-icon">
      <ui-icon name="scale" shape="sheet" decorative="{{true}}" />
    </view>
    <text class="scale-kicker">{{scaleKicker}}</text>
    <text class="scale-title">{{title}}</text>
    <text class="scale-subtitle">
      {{instructions}}，预计 {{estimatedMinutes}} 分钟
    </text>
  </view>

  <view class="unsupported-card glass-surface" wx:if="{{!patientSupported}}">
    <view class="unsupported-icon" aria-hidden="true"></view>
    <text class="unsupported-title">当前量表不适用于该患者</text>
    <text class="unsupported-message">{{unsupportedMessage}}</text>
    <button class="back-button ui-button ui-button--primary" hover-class="ui-button--pressed" bindtap="goBack">返回患者首页</button>
  </view>

  <view class="result-card glass-surface" wx:elif="{{showResult}}">
    <view class="result-icon" aria-hidden="true"></view>
    <text class="result-title">量表已完成</text>
    <view class="result-summary-row">
      <view class="result-stat">
        <text class="result-stat-label">总分</text>
        <text class="result-stat-value">{{result.total_score}}</text>
      </view>
      <view class="result-stat">
        <text class="result-stat-label">风险等级</text>
        <text class="result-stat-value result-risk">
          {{resultRiskLabel}}
        </text>
      </view>
    </view>
    <text class="result-section-title">结果说明</text>
    <text class="result-summary">{{result.summary}}</text>
    <text class="result-section-title">后续建议</text>
    <view class="recommendation-list">
      <view
        class="recommendation-item"
        wx:for="{{result.recommendations}}"
        wx:key="index"
      >
        <view class="recommendation-dot" aria-hidden="true"></view>
        <text class="recommendation-text">{{item}}</text>
      </view>
    </view>
    <button class="back-button ui-button ui-button--primary" hover-class="ui-button--pressed" bindtap="goBack">返回患者首页</button>
  </view>

  <view class="scale-card glass-surface" wx:else>
    <view class="scale-progress-header">
      <text class="scale-progress-text">
        {{questionNumber}} / {{totalQuestions}}
      </text>
      <text class="draft-label">答案自动保存在本机</text>
    </view>

    <view class="scale-progress-track">
      <view
        class="scale-progress-value"
        style="{{'width: ' + progressPercent + '%;'}}"
      ></view>
    </view>

    <view class="question-section">
      <text class="question-number">第 {{questionNumber}} 题</text>
      <text class="question-text">{{currentQuestion}}</text>
    </view>

    <view class="option-list">
      <button
        class="option-button ui-button {{selectedValue === item.value ? 'option-button--selected' : ''}} {{submitting ? 'ui-button--disabled' : ''}}"
        wx:for="{{options}}"
        wx:key="value"
        data-value="{{item.value}}"
        disabled="{{submitting}}"
        aria-pressed="{{selectedValue === item.value}}"
        hover-class="{{submitting ? 'none' : 'ui-clickable--pressed'}}"
        bindtap="selectOption"
      >
        <text class="option-marker">{{item.value}}</text>
        <text class="option-label">{{item.label}}</text>
        <view class="option-check"></view>
      </button>
    </view>

    <view class="navigation-row">
      <button
        class="navigation-button ui-button navigation-button--secondary {{isFirstQuestion || submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{isFirstQuestion || submitting ? 'none' : 'ui-button--pressed'}}"
        disabled="{{isFirstQuestion || submitting}}"
        bindtap="goPrevious"
      >上一题</button>
      <button
        class="navigation-button ui-button navigation-button--primary {{submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{submitting ? 'none' : 'ui-button--pressed'}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="goNext"
      >{{isLastQuestion ? '提交量表' : '下一题'}}</button>
    </view>
  </view>

  <text class="medical-tip">
    本量表结果仅用于辅助筛查，不替代专业医生诊断
  </text>
</view>
