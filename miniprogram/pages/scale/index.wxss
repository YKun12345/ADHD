page {
  min-height: 100%;
  background:
    radial-gradient(circle at 8% 0%, rgba(238, 160, 142, 0.2), transparent 31%),
    radial-gradient(circle at 100% 28%, rgba(173, 145, 220, 0.16), transparent 30%),
    linear-gradient(160deg, #fffaf8 0%, #fff0eb 54%, #f6efff 100%);
}

.scale-page {
  min-height: 0;
  box-sizing: border-box;
  padding: 40rpx 32rpx 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.scale-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx 4rpx;
  text-align: center;
}

.scale-hero-icon {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.54);
  box-shadow: 0 16rpx 40rpx rgba(49, 140, 166, 0.1);
}

.scale-kicker {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.scale-title {
  margin-top: 10rpx;
  color: #17324d;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.4;
}

.scale-subtitle {
  margin-top: 14rpx;
  color: #5d747d;
  font-size: 25rpx;
  line-height: 1.6;
}

.scale-card,
.unsupported-card,
.result-card {
  margin-top: 34rpx;
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.08);
}

.scale-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scale-progress-text {
  color: #17324d;
  font-size: 27rpx;
  font-weight: 700;
}

.draft-label {
  color: #5d747d;
  font-size: 21rpx;
}

.scale-progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8ef;
}

.scale-progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3f7c78, #73c7b6);
  transition: width 220ms ease;
}

.question-section {
  min-height: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 34rpx 4rpx 28rpx;
  border-bottom: 1rpx solid rgba(215, 231, 235, 0.86);
}

.question-number {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.question-text {
  margin-top: 14rpx;
  color: #17324d;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.65;
}

.option-list {
  display: flex;
  flex-direction: column;
}

.option-button {
  width: 100%;
  min-height: 92rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #d7e7eb;
  border-radius: 22rpx;
  color: #526575;
  background: #f7f9fb;
  font-size: 27rpx;
  text-align: left;
}

.option-button::after,
.navigation-button::after,
.back-button::after {
  border: none;
}

.option-button--selected {
  border-color: #3f7c78;
  color: #2f6f6b;
  background: #edf8f5;
  box-shadow: 0 8rpx 22rpx rgba(63, 124, 120, 0.12);
}

.option-marker {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #244c5b;
  background: #e1ecef;
  font-size: 22rpx;
  font-weight: 700;
}

.option-button--selected .option-marker {
  color: #ffffff;
  background: #3f7c78;
}

.option-label {
  flex: 1;
  margin-left: 20rpx;
}

.option-check {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #9bb0b8;
  border-radius: 50%;
  opacity: 0.48;
  transform: scale(0.84);
  transition: opacity 140ms ease, transform 140ms ease;
}

.option-check::after {
  content: "";
  position: absolute;
  top: 7rpx;
  left: 9rpx;
  width: 11rpx;
  height: 6rpx;
  border-bottom: 3rpx solid #ffffff;
  border-left: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.option-button--selected .option-check {
  border-color: #236b80;
  background: #236b80;
  opacity: 1;
  transform: scale(1);
}

.navigation-row {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
}

.navigation-button {
  width: 47%;
  min-height: 90rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.navigation-button--secondary {
  color: #526575;
  background: #edf1f4;
}

.navigation-button--primary,
.back-button {
  color: #ffffff;
  background: #17324d;
}

.unsupported-card,
.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.unsupported-icon,
.result-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.unsupported-icon::before {
  content: '';
  width: 6rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translateY(-7rpx);
}

.unsupported-icon::after {
  content: '';
  position: absolute;
  bottom: 18rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #ffffff;
}

.result-icon::after {
  content: '';
  width: 30rpx;
  height: 16rpx;
  margin-top: -7rpx;
  border-left: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(-45deg);
}

.unsupported-icon {
  background: #c58a43;
}

.result-icon {
  background: #3f7c78;
}

.unsupported-title,
.result-title {
  margin-top: 24rpx;
  color: #17324d;
  font-size: 34rpx;
  font-weight: 700;
}

.unsupported-message,
.result-summary {
  margin-top: 16rpx;
  color: #506b75;
  font-size: 25rpx;
  line-height: 1.7;
}

@media (prefers-reduced-motion: reduce) {
  .progress-value,
  .option-check {
    transition: none;
  }
}

.back-button {
  width: 100%;
  min-height: 90rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.result-summary-row {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.result-stat {
  width: 47%;
  padding: 24rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  border-radius: 18rpx;
  background: #f4f7fa;
}

.result-stat-label {
  color: #5d747d;
  font-size: 22rpx;
}

.result-stat-value {
  margin-top: 8rpx;
  color: #17324d;
  font-size: 31rpx;
  font-weight: 700;
}

.result-risk {
  color: #3f7c78;
  font-size: 26rpx;
}

.result-section-title {
  width: 100%;
  margin-top: 30rpx;
  color: #17324d;
  font-size: 27rpx;
  font-weight: 700;
  text-align: left;
}

.result-summary {
  width: 100%;
  text-align: left;
}

.recommendation-list {
  width: 100%;
  margin-top: 8rpx;
}

.recommendation-item {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  color: #526575;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: left;
}

.recommendation-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin: 13rpx 12rpx 0 0;
  border-radius: 50%;
  background: #3f7c78;
}

.recommendation-text {
  flex: 1;
}

.medical-tip {
  display: block;
  margin-top: 36rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
