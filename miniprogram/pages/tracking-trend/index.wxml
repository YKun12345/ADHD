<ai-copilot page-key="tracking-trend" />
<ui-nav title="14天趋势" />
<view class="trend-page ai-copilot-safe-space">
  <view class="trend-content">
    <view class="trend-heading">
      <view class="trend-heading__mark" aria-hidden="true">
        <ui-icon name="tracking" shape="lens" decorative="true" />
      </view>
      <view>
        <text class="page-title">状态变化趋势</text>
        <text class="page-subtitle">已记录 {{completedCount}} / 14 天</text>
      </view>
    </view>
    <text class="demo-badge" wx:if="{{demoMode}}">本地演示数据</text>
    <view class="metric-tabs" aria-role="radiogroup">
      <view class="metric-tab {{activeMetric === item.key ? 'metric-tab--active' : ''}}" hover-class="trend-control--pressed" aria-role="radio" aria-checked="{{activeMetric === item.key}}" wx:for="{{metricTabs}}" wx:key="key" data-metric="{{item.key}}" bindtap="selectMetric">{{item.label}}</view>
    </view>
    <view class="chart-card glass-surface" wx:if="{{hasData}}">
      <view class="chart-summary"><text>{{metricLabel}}均值</text><text class="average-value">{{averageValue}} {{metricUnit}}</text></view>
      <view class="chart-legend">
        <view class="chart-legend__swatch chart-legend__swatch--{{activeMetric}}"></view>
        <text>{{metricLabel}}每日记录</text>
        <text class="axis-label">纵轴为数值 · 横轴为追踪天数</text>
      </view>
      <text class="chart-data-summary">刻度范围 {{rangeMinimum}} · 中间值 {{rangeMidpoint}} · {{rangeMaximum}} {{metricUnit}}</text>
      <canvas class="trend-canvas" type="2d" id="trackingTrendCanvas" aria-label="14天状态变化趋势图"></canvas>
      <view class="axis-labels"><text>第1天</text><text>第7天</text><text>第14天</text></view>
      <text class="chart-status" wx:if="{{chartStatusMessage}}" aria-live="polite">{{chartStatusMessage}}</text>
      <text class="gap-tip">空白日期表示当天尚未记录，不按 0 计算</text>
    </view>
    <view class="empty-card glass-surface" wx:else><text class="empty-title">暂无追踪数据</text><text>请先返回每日追踪完成至少一天记录</text></view>
    <text class="medical-tip">趋势仅展示客观记录，不替代专业医生诊断</text>
  </view>
</view>
