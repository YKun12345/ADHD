page,.trend-page{min-height:100%;background:#f4f7fa;color:#17324d}.trend-nav{height:96rpx;display:flex;align-items:center;justify-content:space-between;padding:0 28rpx;color:#fff;background:#17324d;font-size:29rpx}.trend-nav view{width:60rpx;font-size:58rpx}.trend-content{padding:46rpx 30rpx}.page-title{display:block;font-size:42rpx;font-weight:700}.page-subtitle{display:block;margin-top:12rpx;color:#718096;font-size:24rpx}.demo-badge{display:inline-block;margin-top:14rpx;padding:5rpx 12rpx;border-radius:999rpx;color:#7a5b2b;background:#fff1b8;font-size:20rpx}.metric-tabs{display:flex;justify-content:space-between;margin-top:28rpx}.metric-tab{width:31%;padding:18rpx 0;border-radius:16rpx;color:#64748b;background:#fff;text-align:center}.metric-tab--active{color:#fff;background:#3f7c78;font-weight:600}.chart-card,.empty-card{margin-top:24rpx;padding:30rpx;border-radius:26rpx;background:#fff;box-shadow:0 14rpx 38rpx rgba(23,50,77,.08)}.chart-summary{display:flex;justify-content:space-between;align-items:center;color:#64748b;font-size:23rpx}.average-value{color:#17324d;font-size:30rpx;font-weight:700}.trend-canvas{width:660rpx;height:440rpx;margin-top:20rpx}.axis-labels{display:flex;justify-content:space-between;color:#8795a3;font-size:19rpx}.gap-tip{display:block;margin-top:20rpx;color:#718096;font-size:21rpx;text-align:center}.empty-card{display:flex;flex-direction:column;align-items:center;padding:70rpx 30rpx;color:#718096;text-align:center}.empty-title{margin-bottom:14rpx;color:#17324d;font-size:30rpx;font-weight:700}.medical-tip{display:block;margin-top:32rpx;color:#8795a3;font-size:21rpx;text-align:center}
