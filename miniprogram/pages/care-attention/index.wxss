page { background: #edf7fa; color: #17324d; }
.attention-page { padding: 24rpx 28rpx 72rpx; padding-bottom: calc(72rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.sheet { margin: 22rpx 0; padding: 28rpx; border: 1rpx solid #d7e6ed; border-radius: 28rpx; background: rgba(255,255,255,.94); }
.title { display: block; font-size: 32rpx; font-weight: 700; }
.note { display: block; font-size: 26rpx; color: #536d85; line-height: 1.8; margin: 16rpx 0; }
.error { display: block; font-size: 26rpx; color: #a93434; line-height: 1.8; }
button { margin-top: 18rpx; font-size: 27rpx; color: #17324d; border-radius: 18rpx; background: #e8f0fc; }
textarea { width: 100%; min-height: 180rpx; padding: 18rpx; box-sizing: border-box; background: #f2f6fb; color: #17324d; font-size: 27rpx; border-radius: 16rpx; }
.history-row { margin-top: 20rpx; padding-top: 12rpx; border-top: 1rpx solid #d7e6ed; overflow-wrap: anywhere; }

@import "../../styles/product-page.wxss";
page { color: var(--ui-ink); background: var(--ui-page-background); }
