<task-instructions visible="{{instructionVisible}}" content="{{taskInstruction}}" remaining="{{instructionRemaining}}" ready="{{instructionReady}}" bindstart="handleInstructionStart" />
<ai-copilot wx:if="{{!instructionVisible && !submitting && (phase === 'intro' || phase === 'result')}}" page-key="nback" />
<ui-nav title="两步位置记忆任务" />
<view class="task-page theme-cosmos ai-copilot-safe-space"><view class="task-content">
  <view class="task-heading"><text class="task-kicker">空间工作记忆更新</text><text class="task-title">两步位置记忆任务</text><text class="task-subtitle">每次与两次之前的位置比较：第3次比第1次，第4次比第2次</text></view>
  <view class="task-card" wx:if="{{phase === 'intro' || phase === 'paused'}}"><text class="section-title">测试说明</text><text class="instruction">记住每次亮起的方格位置。如果当前位置与两次之前相同，选择“匹配”；否则选择“不匹配”。前两次点击黄色方格确认并建立记忆，不计分；之后选择答案推进，无超时跳题。</text><view class="notice protocol-note">连续移动筛查版共 {{totalTrials}} 次，连续完成；结果不可与标准化临床工具直接等同。</view><text wx:if="{{phase === 'paused'}}" class="paused-text">本项已中断，需要重新开始</text><button class="primary-button" bindtap="startTest">开始测试</button></view>
  <view class="task-card" wx:elif="{{phase === 'memory' || phase === 'testing' || phase === 'interval'}}"><view class="progress-row"><text>第 {{currentTrial}} / {{totalTrials}} 题</text><text>{{progressPercent}}%</text></view><view class="progress-track"><view class="progress-value" style="{{'width:' + progressPercent + '%;'}}"></view></view><view class="nback-grid"><view wx:for="{{grid}}" wx:key="index" class="nback-cell {{item.active ? (phase === 'memory' ? 'nback-cell--memory' : 'nback-cell--active') : ''}}" data-index="{{item.index}}" data-trial="{{currentTrial}}" bindtap="handleCellTap"></view></view><text wx:if="{{phase === 'memory'}}" class="memory-prompt">请记住位置，再点击黄色方格确认</text><view wx:if="{{phase === 'testing'}}" class="answer-row"><button data-trial="{{currentTrial}}" data-match="true" bindtap="handleAnswer">匹配</button><button data-trial="{{currentTrial}}" data-match="false" bindtap="handleAnswer">不匹配</button></view></view>
  <view class="task-card result-card" wx:elif="{{phase === 'result'}}"><text class="section-title">结果摘要</text><text class="instruction">共 {{totalTrials}} 次呈现，前两次仅记忆；答对 {{result.correct_trials}} / {{result.total_trials}} 次判断</text><view class="result-grid"><view class="result-stat"><text class="result-value">{{result.accuracy}}%</text><text class="result-label">正确率</text></view><view class="result-stat"><text class="result-value">{{result.d_prime}}</text><text class="result-label">辨别指数</text></view><view class="result-stat"><text class="result-value">{{result.hits}}</text><text class="result-label">命中</text></view><view class="result-stat"><text class="result-value">{{result.false_alarms}}</text><text class="result-label">虚报</text></view></view><text class="instruction">漏判匹配 {{result.misses}} 次 · 误判匹配 {{result.false_alarms}} 次 · 未作答 {{result.omissions}} 次</text><text class="sync-status">{{syncStatus}}</text><button wx:if="{{syncStatus === '待同步'}}" class="primary-button" bindtap="retrySync">重新同步</button><button wx:if="{{mode === 'battery'}}" class="secondary-button" bindtap="goNext">继续完整评估</button><button class="secondary-button" bindtap="startTest">重新测试</button></view>
  <text class="medical-tip">本测试仅记录客观工作记忆指标，不替代专业医生诊断</text>
</view></view>
