<task-instructions visible="{{instructionVisible}}" content="{{taskInstruction}}" remaining="{{instructionRemaining}}" ready="{{instructionReady}}" bindstart="handleInstructionStart" />
<ai-copilot wx:if="{{!instructionVisible && !submitting && (phase === 'intro' || phase === 'result')}}" page-key="trail" />
<ui-nav title="连线测试" />
<view class="task-page theme-lavender ai-copilot-safe-space"><view class="task-content">
  <view class="task-heading"><text class="task-kicker">视觉搜索与认知转换</text><text class="task-title">连线测试</text><text class="task-subtitle">先完成数字顺序，再完成数字与字母交替</text></view>
  <view class="task-card" wx:if="{{phase === 'intro' || phase === 'paused'}}"><text class="section-title">测试说明</text><text class="instruction">A 阶段按 1、2、3…30 依次点击；B 阶段按 1、A、2、B…15、O 交替点击，共30个节点。点错后继续寻找当前正确目标。</text><view class="notice">A、B 两阶段连续完成。节点位置会在每次开始时重新排列，正确点击后显示连接路径；系统分别记录两个阶段的用时和错误。</view><text wx:if="{{phase === 'paused'}}" class="paused-text">测试已中断，请重新开始整项测试</text><button class="primary-button" bindtap="startTest">阅读说明并开始</button></view>
  <view class="task-card" wx:elif="{{phase === 'testing'}}"><view class="progress-row"><text>{{stageTitle}}</text><text>错误 {{errors}}</text></view><view class="trail-status"><text>已连接 {{currentIndex}} / {{nodeCount}}</text><text wx:if="{{!boardReady}}">准备节点布局…</text></view><view class="progress-track"><view class="progress-value" style="{{'width:' + progressPercent + '%;'}}"></view></view><view id="trail-board" class="trail-board" style="{{'height:' + boardHeight + 'px;'}}"><canvas id="trail-lines" canvas-id="trail-lines" class="trail-lines"></canvas><view wx:for="{{nodes}}" wx:key="id" class="trail-node {{item.order < currentIndex ? 'trail-node--done' : ''}}" style="{{'left:' + item.x + '%;top:' + item.y + '%;width:' + item.size + 'px;height:' + item.size + 'px;'}}" data-label="{{item.label}}" data-tap-token="{{tapToken}}" aria-role="button" aria-label="节点 {{item.label}}" bindtap="handleNodeTap">{{item.label}}</view></view></view>
  <view class="task-card trail-transition" wx:elif="{{phase === 'transition'}}"><text class="section-title">A 阶段完成</text><text class="instruction">用时 {{elapsedText}}。接下来按数字与字母交替点击：1 → A → 2 → B … 15 → O。</text><view class="notice">B 阶段即将自动开始，此提示时间不计入测试用时。</view></view>
  <view class="task-card result-card" wx:elif="{{phase === 'result'}}"><text class="section-title">结果摘要</text><view class="result-grid"><view class="result-stat"><text class="result-value">{{result.elapsed_ms}} ms</text><text class="result-label">总用时</text></view><view class="result-stat"><text class="result-value">{{result.errors}}</text><text class="result-label">错误次数</text></view></view><view class="trail-stage-summary" wx:for="{{result.stages}}" wx:key="stage"><text class="trail-stage-summary__title">{{item.stage}} 阶段 · {{item.nodeCount}} 个节点</text><text>用时 {{item.elapsedMs}} ms · 错误 {{item.errors}} 次</text></view><text class="sync-status">{{syncStatus}}</text><button wx:if="{{syncStatus === '待同步'}}" class="primary-button" bindtap="retrySync">重新同步</button><button wx:if="{{mode === 'battery'}}" class="secondary-button" bindtap="goNext">继续完整评估</button><button class="secondary-button" bindtap="startTest">重新测试</button></view>
  <text class="medical-tip">本测试仅记录客观执行表现，不替代专业医生诊断</text>
</view></view>
