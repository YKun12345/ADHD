<onboarding-guide role="researcher" bind:visibilitychange="onOnboardingVisibilityChange" />
<ai-copilot wx:if="{{!onboardingVisible}}" page-key="doctor-home" bottom-inset="{{60}}" />
<view class="doctor-page ai-copilot-safe-space">
  <ui-nav title="{{showPatientsSection ? listTitle : '医生工作台'}}" showBack="{{false}}" rightText="账户" bind:righttap="toggleAccountMenu" />
  <view wx:if="{{accountMenuVisible}}" class="account-backdrop" bindtap="closeAccountMenu"></view>
  <view wx:if="{{accountMenuVisible}}" class="account-menu" style="top: {{accountMenuTop}}px"><text class="account-menu-title">我的账户</text><button class="account-button" bindtap="openPrivacySettings">账号与隐私</button><button class="account-button account-logout" bindtap="logout">退出登录</button></view>

  <view class="doctor-content">
    <agent-actions id="workbench-next-actions" wx:if="{{!showPatientsSection}}" tone="plain" />
    <view wx:if="{{!showPatientsSection}}" class="hero-card">
      <text class="hero-kicker">评估协作与持续随访</text>
      <text class="hero-title">{{doctorName}}，今天好</text>
      <text class="hero-copy">查看当前随访状态，继续核对材料或处理待办。</text>
      <view class="hero-decoration" aria-hidden="true"><ui-icon class="doctor-icon" name="plan" shape="line" tone="inverse" /></view>
    </view>

    <view wx:if="{{!showPatientsSection}}" class="communication-shortcuts">
      <view id="open-patients" class="doctor-settings-entry" aria-role="button" bindtap="openPatientList" hover-class="doctor-settings-entry--pressed"><ui-icon class="doctor-icon" name="account" shape="line" /><text class="doctor-entry-label">查看用户</text><view class="entry-chevron" aria-hidden="true"></view></view>
      <view class="doctor-settings-entry" aria-role="button" bindtap="openCommunication" hover-class="doctor-settings-entry--pressed"><ui-icon class="doctor-icon" name="message" shape="line" /><text class="doctor-entry-label">沟通与待办</text><view class="entry-chevron" aria-hidden="true"></view></view>
    </view>

    <view wx:if="{{!showPatientsSection}}" class="stats-row">
      <view class="stat-card stat-card--blue" data-stat="patients" bindtap="openStatistic" aria-role="button" aria-label="查看有效共享用户" hover-class="doctor-settings-entry--pressed">
        <ui-icon class="doctor-icon" name="account" shape="line" />
        <view class="stat-copy">
        <text class="stat-value">{{stats.patientCount}}</text>
        <text class="stat-label">有效共享用户</text>
        </view>
      </view>
      <view class="stat-card stat-card--orange" data-stat="reports" bindtap="openStatistic" aria-role="button" aria-label="查看本周新报告" hover-class="doctor-settings-entry--pressed">
        <ui-icon class="doctor-icon" name="report" shape="line" />
        <view class="stat-copy">
        <text class="stat-value">{{stats.weeklyReportCount}}</text>
        <text class="stat-label">本周新报告</text>
        </view>
      </view>
      <view class="stat-card stat-card--violet" data-stat="imaging" bindtap="openStatistic" aria-role="button" aria-label="查看待完善影像" hover-class="doctor-settings-entry--pressed">
        <ui-icon class="doctor-icon" name="imaging" shape="line" />
        <view class="stat-copy">
        <text class="stat-value">{{stats.pendingImagingCount}}</text>
        <text class="stat-label">待完善影像</text>
        </view>
      </view>
      <view class="stat-card stat-card--message" data-stat="messages" bindtap="openStatistic" aria-role="button" aria-label="查看用户消息" hover-class="doctor-settings-entry--pressed"><ui-icon class="doctor-icon" name="message" shape="line" /><view class="stat-copy"><text class="stat-value">{{careTotals.unread}}</text><text class="stat-label">未读用户消息</text></view></view>
      <view class="stat-card stat-card--task" data-stat="tasks" bindtap="openStatistic" aria-role="button" aria-label="查看待办用户任务" hover-class="doctor-settings-entry--pressed"><ui-icon class="doctor-icon" name="plan" shape="line" /><view class="stat-copy"><text class="stat-value">{{careTotals.pending}}</text><text class="stat-label">待办用户任务</text></view></view>
    </view>

    <block wx:if="{{showPatientsSection}}">
    <form wx:if="{{statisticFilter === 'patients'}}" class="bind-card" bindsubmit="bindPatient">
      <view class="section-heading">
        <view class="invite-heading"><ui-icon class="doctor-icon" name="account" shape="line" /><text class="section-title">邀请用户共享</text></view>
        <text class="section-note">双方确认资料、评估、记录、任务消息及已有影像分析范围，有效期90天；在账号与隐私中确认或撤回。</text>
      </view>
      <view class="bind-row">
        <input
          class="bind-input"
          type="text"
          value="{{bindEmail}}"
          disabled="{{binding}}"
          placeholder="用户邮箱"
          bindinput="onBindEmailInput"
        />
        <button class="bind-button {{binding ? 'bind-button--disabled' : ''}}" form-type="submit" loading="{{binding}}" disabled="{{binding}}">邀请</button>
      </view>
    </form>

    <view class="list-heading">
      <text class="section-title">{{listTitle}}</text>
      <text class="list-total">{{patients.length}} 人</text>
    </view>
    <text wx:if="{{listNote}}" class="state-note">{{listNote}}</text>
    <button wx:if="{{statisticFilter !== 'patients'}}" class="retry-button" bindtap="showAllPatients">查看全部共享用户</button>

    <view class="filter-card">
      <input class="search-input" value="{{searchQuery}}" placeholder="搜索用户姓名或邮箱" bindinput="onSearchInput" />
      <view class="filter-row">
        <view wx:for="{{riskFilters}}" wx:key="value" class="filter-chip {{riskFilter === item.value ? 'filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="selectRiskFilter">{{item.label}}</view>
      </view>
      <view class="filter-row">
        <view wx:for="{{completionFilters}}" wx:key="value" class="filter-chip {{completionFilter === item.value ? 'filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="selectCompletionFilter">{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="state-card">正在同步共享数据…</view>
    <view wx:elif="{{errorText}}" class="state-card state-card--error">
      <text>{{errorText}}</text>
      <button class="retry-button" bindtap="retryLoad">重新加载</button>
    </view>
    <view wx:elif="{{patients.length === 0}}" class="state-card">
      <text>{{allPatients.length ? '没有符合当前条件的用户' : '还没有已确认共享的用户'}}</text>
      <text class="state-note">{{allPatients.length ? '调整搜索或筛选条件后再试。' : '发出邀请，待本人或监护人确认后显示共享档案。'}}</text>
    </view>

    <view wx:else class="patient-list">
      <view
        wx:for="{{patients}}"
        wx:key="patientId"
        class="patient-card"
        data-id="{{item.patientId}}"
        bindtap="openPatient"
        aria-role="button"
        aria-label="查看 {{item.patientName}} 的报告"
      >
        <view class="patient-main">
          <view class="patient-avatar">{{item.avatarText}}</view>
          <view class="patient-info">
            <text class="patient-name">{{item.patientName}}</text>
            <text class="patient-email">{{item.patientEmail}}</text>
          </view>
          <text class="risk-tag risk-tag--{{item.riskLevel}}">{{item.riskText}}</text>
        </view>
        <view class="patient-meta">
          <text>{{item.progressText}}</text>
          <text class="patient-next">{{item.nextStepText}}</text>
          <view class="care-summary-tags"><text class="care-summary-tag" wx:if="{{item.unread}}">未读消息 {{item.unread}}</text><text class="care-summary-tag" wx:if="{{item.pending}}">待办任务 {{item.pending}}</text></view>
        </view>
      </view>
    </view>

    </block>
    <view wx:if="{{!showPatientsSection && errorText}}" class="state-card state-card--error"><text>{{errorText}}</text><button class="retry-button" bindtap="retryLoad">重新加载</button></view>
    <view wx:if="{{!showPatientsSection}}" class="work-shortcuts">
      <text class="work-shortcuts-title">其他工作</text>
      <view class="work-shortcuts-grid">
        <button class="work-shortcut-button" bindtap="openCareAttention"><ui-icon class="doctor-icon" name="plan" shape="line" /><text class="work-shortcut-label">审核与关注待办</text><view class="entry-chevron" aria-hidden="true"></view></button>
        <button class="work-shortcut-button" bindtap="openTransfers"><ui-icon class="doctor-icon" name="report" shape="line" /><text class="work-shortcut-label">接收工作交接</text><view class="entry-chevron" aria-hidden="true"></view></button>
        <button class="work-shortcut-button" bindtap="openTransferredWork"><ui-icon class="doctor-icon" name="report" shape="line" /><text class="work-shortcut-label">已接收事项</text><view class="entry-chevron" aria-hidden="true"></view></button>
      </view>
    </view>
  </view>
</view>
<role-nav id="primary-role-nav" active-key="{{showPatientsSection ? 'patients' : 'home'}}" />
