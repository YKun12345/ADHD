page {
  min-height: 100%;
  color: var(--ui-ink);
  background: var(--ui-page-background);
}

.doctor-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx 28rpx calc(180rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
}

.account-backdrop {
  position: fixed;
  inset: 0;
  z-index: 42;
  background: rgba(24, 55, 71, .1);
}
.account-menu {
  position: fixed;
  top: 100px;
  right: 28rpx;
  z-index: 45;
  min-width: 260rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: var(--ui-radius-lg);
  background: #fff;
  box-shadow: 0 16rpx 55rpx rgba(24, 55, 71, .12);
}
.account-menu-title {
  display: block;
  margin: 4rpx 8rpx 10rpx;
  color: var(--ui-text);
  font-size: 22rpx;
}
.account-button {
  margin: 0;
  padding: 18rpx 10rpx;
  color: var(--ui-ink);
  background: transparent;
  text-align: left;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.7;
}
.account-menu .account-logout {
  color: #a45d57;
  border-top: 1rpx solid var(--ui-line);
}
.account-button::after,
.work-shortcut-button::after,
.bind-button::after,
.retry-button::after { border: 0; }

.hero-card,
.stats-row,
.bind-card,
.patient-card,
.state-card,
.work-shortcuts {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, .92);
  border-radius: var(--ui-radius-lg);
  box-shadow: var(--ui-shadow-soft);
}
.hero-card {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 34rpx 30rpx 36rpx;
  color: #fff;
  background: var(--ui-focus);
}
.hero-kicker,
.hero-title,
.hero-copy { position: relative; z-index: 1; }
.hero-kicker { font-size: 23rpx; opacity: .88; }
.hero-title { margin-top: 18rpx; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.hero-copy { margin-top: 18rpx; font-size: 24rpx; line-height: 1.7; opacity: .92; }
.hero-decoration {
  position: absolute;
  top: 40rpx;
  right: 25rpx;
  opacity: .16;
  transform: scale(1.8);
}

.communication-shortcuts { display: flex; gap: 18rpx; margin-top: 20rpx; }
.doctor-settings-entry {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  min-height: 106rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .92);
  border-radius: var(--ui-radius-lg);
  color: var(--ui-ink);
  background: #fff;
  font-size: 26rpx;
  box-shadow: var(--ui-shadow-soft);
}
.doctor-settings-entry .doctor-icon { flex: none; margin-right: 12rpx; transform: scale(.78); }
.doctor-entry-label { flex: 1; line-height: 1.5; }
.doctor-settings-entry--pressed { opacity: .72; }
.entry-chevron {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-top: 3rpx solid #8e9aa5;
  border-right: 3rpx solid #8e9aa5;
  transform: rotate(45deg);
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fff;
}
.stat-card {
  display: flex;
  align-items: center;
  flex: 0 0 calc(50% - 8rpx);
  min-width: 0;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 18rpx 12rpx;
  border: 1rpx solid var(--ui-line);
  border-radius: 24rpx;
  color: var(--ui-ink);
  background: #fff;
}
.stat-card .doctor-icon { flex: none; margin-right: 8rpx; transform: scale(.76); }
.stat-copy { display: flex; flex-direction: column-reverse; flex: 1; min-width: 0; }
.stat-value,
.stat-label { display: block; }
.stat-value { margin-top: 8rpx; font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.stat-label { color: var(--ui-text); font-size: 22rpx; line-height: 1.45; }
.stat-card--violet { background: #fff8ef; border-color: #f4e6d4; }
.stat-card--task { flex-basis: 100%; }

.bind-card {
  display: block;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 28rpx;
  background: #fff;
}
.section-heading { display: block; }
.invite-heading { display: flex; align-items: center; gap: 12rpx; }
.invite-heading .doctor-icon { flex: none; transform: scale(.85); }
.section-title { color: var(--ui-ink); font-size: 32rpx; font-weight: 700; line-height: 1.45; }
.section-note {
  display: block;
  margin-top: 16rpx;
  color: var(--ui-text);
  font-size: 24rpx;
  line-height: 1.75;
}
.bind-row { display: flex; width: 100%; min-width: 0; gap: 12rpx; margin-top: 28rpx; }
.bind-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #dce7ee;
  border-radius: 22rpx;
  color: var(--ui-ink);
  background: #f9fcff;
  font-size: 26rpx;
}
.bind-button,
.retry-button { display: flex; align-items: center; justify-content: center; margin: 0; border: 0; }
.bind-button {
  flex: 0 0 136rpx;
  width: 136rpx;
  min-height: 84rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  background: var(--ui-primary);
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
}
.bind-button--disabled { color: #fff; background: var(--ui-primary); opacity: .55; }

.list-heading { display: flex; align-items: center; gap: 22rpx; margin: 36rpx 0 22rpx; }
.list-total { color: var(--ui-text); font-size: 27rpx; }
.filter-card { margin-bottom: 26rpx; }
.search-input {
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 1rpx solid #fff;
  border-radius: var(--ui-radius-lg);
  color: var(--ui-ink);
  background: rgba(255, 255, 255, .72);
  font-size: 26rpx;
}
.filter-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.filter-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  border: 1rpx solid #fff;
  border-radius: 999rpx;
  color: var(--ui-text);
  background: rgba(255, 255, 255, .9);
  font-size: 24rpx;
  line-height: 1.5;
}
.filter-chip--active { color: #fff; background: var(--ui-primary); border-color: var(--ui-primary); }

.patient-list { display: flex; flex-direction: column; gap: 20rpx; }
.patient-card { padding: 26rpx; background: #fff; }
.patient-main { display: flex; align-items: center; }
.patient-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  color: #638591;
  background: #eaf1f5;
  font-size: 31rpx;
  font-weight: 600;
}
.patient-info { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 20rpx; }
.patient-name { color: var(--ui-ink); font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.patient-email { overflow: hidden; margin-top: 8rpx; color: var(--ui-text); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.risk-tag { flex: none; margin-left: 10rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--ui-text); background: #eff6fc; font-size: 21rpx; }
.risk-tag--high { color: #a13f3f; background: #fff0ed; }
.risk-tag--medium { color: #946022; background: #fff4e3; }
.risk-tag--low { color: #33735f; background: #eaf7f1; }
.patient-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--ui-line);
  color: var(--ui-text);
  font-size: 23rpx;
  line-height: 1.6;
}
.patient-next { color: #397482; }
.care-summary-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.care-summary-tag { padding: 6rpx 12rpx; border-radius: 999rpx; color: #536c77; background: #eff6f9; font-size: 21rpx; }

.state-card { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; padding: 46rpx 28rpx; color: var(--ui-text); background: rgba(255, 255, 255, .88); font-size: 25rpx; line-height: 1.65; text-align: center; }
.state-note { margin-top: 12rpx; font-size: 22rpx; }
.state-card--error { color: #9b4e4e; }
.retry-button { min-width: 180rpx; min-height: 80rpx; margin-top: 22rpx; border-radius: 22rpx; color: #287482; background: #e8f4f7; font-size: 24rpx; }

.work-shortcuts { margin-top: 20rpx; padding: 26rpx 24rpx 10rpx; background: #faf8f3; }
.work-shortcuts-title { display: block; margin: 0 6rpx 16rpx; color: var(--ui-ink); font-size: 29rpx; font-weight: 700; }
.work-shortcuts-grid { display: flex; flex-direction: column; }
.work-shortcut-button {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 12rpx 6rpx;
  border-bottom: 1rpx solid #eae9e4;
  border-radius: 0;
  color: var(--ui-ink);
  background: transparent;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}
.work-shortcut-button:last-child { border-bottom: 0; }
.work-shortcuts-grid .doctor-icon { flex: none; margin-right: 12rpx; transform: scale(.76); }
.work-shortcut-label { flex: 1; }
.work-shortcuts-grid .entry-chevron { margin-right: 10rpx; }
