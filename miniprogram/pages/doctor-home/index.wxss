page {
  min-height: 100%;
  background: #eef3fa;
  background-image: radial-gradient(circle at 92% 5%, rgba(235, 158, 91, 0.19), transparent 28%), linear-gradient(165deg, #f8fbff 0%, #edf3fb 48%, #f7f2f8 100%);
}

.doctor-content {
  box-sizing: border-box;
  min-height: 100%;
  padding: 34rpx 30rpx calc(56rpx + constant(safe-area-inset-bottom));
  padding: 34rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
}

.hero-card,
.bind-card,
.patient-card,
.state-card {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 50rpx rgba(48, 70, 112, 0.09);
}

.hero-card {
  display: flex;
  flex-direction: column;
  padding: 42rpx 38rpx;
  border-radius: 34rpx;
  color: #f8fbff;
  background: linear-gradient(135deg, #284b7a 0%, #46689b 58%, #6b668e 100%);
}

.hero-kicker { font-size: 21rpx; letter-spacing: 4rpx; opacity: 0.7; }
.hero-title { margin-top: 14rpx; font-size: 39rpx; font-weight: 750; }
.hero-copy { margin-top: 14rpx; font-size: 24rpx; line-height: 1.65; opacity: 0.86; }

.stats-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 22rpx; }
.stat-card { flex: 0 0 calc(33.333% - 10rpx); min-width: 0; padding: 25rpx 10rpx; border-radius: 24rpx; text-align: center; box-sizing: border-box; }
.stat-card--blue { color: #1c5278; background: #dfeefa; }
.stat-card--orange { color: #8b4b20; background: #fae9d9; }
.stat-card--violet { color: #5c507e; background: #ebe6f5; }
.stat-value, .stat-label { display: block; }
.stat-value { font-size: 38rpx; font-weight: 760; }
.stat-label { margin-top: 7rpx; font-size: 21rpx; }

.bind-card { display: block; width: 100%; box-sizing: border-box; overflow: hidden; margin-top: 26rpx; padding: 30rpx; border-radius: 28rpx; background: rgba(255, 255, 255, 0.86); }
.section-heading, .list-heading { display: flex; align-items: center; justify-content: space-between; }
.section-title { color: #263e5d; font-size: 30rpx; font-weight: 720; }
.section-note, .list-total { color: #748297; font-size: 21rpx; }
.bind-row { display: flex; width: 100%; min-width: 0; gap: 14rpx; margin-top: 22rpx; }
.bind-input { flex: 1; width: 0; min-width: 0; height: 88rpx; box-sizing: border-box; padding: 0 24rpx; border: 1rpx solid #ced9e7; border-radius: 20rpx; color: #263e5d; background: #f7f9fc; }
.bind-button, .retry-button { display: flex; align-items: center; justify-content: center; margin: 0; border: 0; }
.bind-button { flex: 0 0 142rpx; width: 142rpx; min-height: 88rpx; border-radius: 20rpx; color: white; font-size: 26rpx; background: #315f91; }
.bind-button::after, .retry-button::after { border: 0; }

.list-heading { margin: 38rpx 6rpx 18rpx; }
.patient-list { display: flex; flex-direction: column; gap: 18rpx; }
.patient-card { padding: 28rpx; border-radius: 27rpx; background: rgba(255, 255, 255, 0.88); }
.patient-main { display: flex; align-items: center; }
.patient-avatar { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; color: #315f91; font-size: 29rpx; font-weight: 750; background: #e1edf8; }
.patient-info { flex: 1; min-width: 0; display: flex; flex-direction: column; margin-left: 20rpx; }
.patient-name { color: #263e5d; font-size: 29rpx; font-weight: 720; }
.patient-email { margin-top: 7rpx; overflow: hidden; color: #748297; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.risk-tag { padding: 8rpx 14rpx; border-radius: 999rpx; color: #67758a; font-size: 21rpx; background: #edf1f6; }
.risk-tag--high { color: #a13f3f; background: #fde4e1; }
.risk-tag--medium { color: #946022; background: #faecd4; }
.risk-tag--low { color: #33735f; background: #dff1e9; }
.patient-meta { display: flex; flex-direction: column; gap: 8rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e9edf3; color: #65758b; font-size: 22rpx; }
.patient-next { color: #365f8c; }

.state-card { display: flex; flex-direction: column; align-items: center; padding: 50rpx 30rpx; border-radius: 27rpx; color: #69788d; background: rgba(255, 255, 255, 0.76); }
.state-note { margin-top: 12rpx; font-size: 22rpx; }
.state-card--error { color: #9b4e4e; }
.retry-button { min-width: 180rpx; min-height: 88rpx; margin-top: 22rpx; border-radius: 18rpx; color: #315f91; font-size: 24rpx; background: #e4eef8; }
.filter-card { margin-bottom: 22rpx; padding: 22rpx; border-radius: 26rpx; background: rgba(255,255,255,.82); }
.search-input { height: 78rpx; box-sizing: border-box; padding: 0 22rpx; border: 1rpx solid #d9e2eb; border-radius: 18rpx; background: #f8fafc; font-size: 25rpx; }
.filter-row { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.filter-chip { margin: 6rpx 10rpx 0 0; padding: 10rpx 16rpx; border-radius: 999rpx; color: #64758a; background: #eef2f6; font-size: 21rpx; }
.filter-chip--active { color: #fff; background: #3f6f9f; }
.stat-card--message { color: #7a4e68; background: #f5e7ef; }
.stat-card--task { color: #6d542e; background: #fff0ca; }
.care-summary-tags { display: flex; flex-wrap: wrap; }
.care-summary-tags text { margin: 6rpx 10rpx 0 0; padding: 6rpx 11rpx; border-radius: 999rpx; color: #6a5260; background: #f4e8ef; font-size: 21rpx; }
.doctor-settings-entry { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 28rpx 0 12rpx; border-radius: 22rpx; color: #3f6388; font-size: 25rpx; background: rgba(255, 255, 255, 0.72); }
.doctor-settings-entry--pressed { opacity: 0.72; }

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 12rpx 0 20rpx;
  border-radius: 22rpx;
  color: #b04545;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.72);
}
.logout-button--pressed { opacity: 0.72; }
