<ui-nav title="数字广度测试" />
<view class="task-page ai-copilot-safe-space"><view class="task-content">
  <view class="task-heading"><text class="task-kicker">短时记忆与信息操作</text><text class="task-title">数字广度测试</text><text class="task-subtitle">完成顺背与倒背两个阶段，每个长度测试两轮</text></view>
  <view class="task-card" wx:if="{{phase === 'intro' || phase === 'paused'}}"><text class="section-title">测试说明</text><text class="instruction">数字会逐个出现。顺背阶段按原顺序输入；倒背阶段按相反顺序输入。所有预设长度都会完成。</text><view class="notice">呈现数字时请不要点击，数字消失后再使用键盘作答。</view><text wx:if="{{phase === 'paused'}}" class="paused-text">本项已中断，需要重新开始</text><button class="primary-button" bindtap="startTest">开始测试</button></view>
  <view class="task-card" wx:elif="{{phase === 'presenting' || phase === 'recall' || phase === 'feedback'}}"><view class="progress-row"><text>{{directionText}} · 第 {{currentTrial}} / {{totalTrials}} 轮</text><text>{{progressPercent}}%</text></view><view class="progress-track"><view class="progress-value" style="{{'width:' + progressPercent + '%;'}}"></view></view><view class="stimulus-area"><text wx:if="{{phase === 'presenting'}}" class="shown-digit">{{shownDigit}}</text><block wx:else><text class="answer-display">{{answerText || '请输入数字'}}</text><view class="digit-keypad"><button wx:for="{{keypad}}" wx:key="*this" data-digit="{{item}}" bindtap="handleDigitTap">{{item}}</button></view><view class="keypad-actions"><button bindtap="handleDelete">删除</button><button class="submit-key" bindtap="submitAnswer">提交</button></view></block></view></view>
  <view class="task-card" wx:elif="{{phase === 'result'}}"><text class="section-title">结果摘要</text><view class="result-grid"><view class="result-stat"><text class="result-value">{{result.forward_max_span}}</text><text class="result-label">顺背最大跨度</text></view><view class="result-stat"><text class="result-value">{{result.backward_max_span}}</text><text class="result-label">倒背最大跨度</text></view><view class="result-stat"><text class="result-value">{{result.accuracy}}%</text><text class="result-label">正确轮次率</text></view><view class="result-stat"><text class="result-value">{{result.correct_digits}}</text><text class="result-label">正确数字数</text></view></view><text class="sync-status">{{syncStatus}}</text><button wx:if="{{syncStatus === '待同步'}}" class="primary-button" bindtap="retrySync">重新同步</button><button wx:if="{{mode === 'battery'}}" class="secondary-button" bindtap="goNext">继续完整评估</button><button class="secondary-button" bindtap="startTest">重新测试</button></view>
  <text class="medical-tip">本测试仅记录客观记忆指标，不替代专业医生诊断</text>
</view></view>
