<ui-nav title="阶段复核与后续安排" showBack="{{true}}" fallbackUrl="{{role === 'researcher' ? '/pages/doctor-home/index' : '/pages/home/index'}}" />
<ai-copilot page-key="cycle-review" patient-id="{{patientId}}" cycle-id="{{cycleId}}" />
<view class="review-page product-page product-form-page"><view class="sheet"><text class="title">实际周期 {{cycle.start_date}} 至 {{cycle.end_date}}</text><text class="note">{{coverageText}}</text><text class="note">记录覆盖不代表治疗效果。短周期量表和跨设备结果仍按各自局限解释。</text><text wx:if="{{errorText}}" class="error">{{errorText}}</text><text wx:if="{{statusText}}" class="note">{{statusText}}</text><button disabled="{{busy || loading}}" bindtap="reload">重新读取实际材料</button><button bindtap="openRecovery">查看待确认原件</button><button wx:if="{{pendingId}}" disabled="{{busy}}" bindtap="queryPending">按原编号查询本次确认</button></view>
<view wx:for="{{records}}" wx:key="record_id" class="sheet"><text class="title">{{item.record_date}} · 修订 {{item.revision}}</text><text class="note">专注：{{item.focusText}} · {{item.is_backfill ? '补录' : '当日记录'}}</text><text selectable="true">{{item.noteText}}</text></view>
<view wx:if="{{canConfirm}}" class="sheet"><text class="title">{{cycle.cycle_type === 'professional' ? '由实际负责医生核对确认' : '本人自助周期决定，不是专业复核'}}</text><text wx:if="{{adoptionId}}" class="note">已带入你核对的周期摘要，修改正文请回星仔重新核对。阶段决定、局限与原因仍由你填写。</text><picker range="{{decisions}}" range-key="label" value="{{decisionIndex}}" disabled="{{busy || !!pendingId}}" bindchange="selectDecision"><view class="note">{{decisions[decisionIndex].label}}</view></picker><textarea value="{{body}}" data-field="body" bindinput="onField" maxlength="8000" disabled="{{busy || !!pendingId || !!adoptionId}}" placeholder="实际阶段意见"/><textarea value="{{limitations}}" data-field="limitations" bindinput="onField" maxlength="2000" disabled="{{busy || !!pendingId}}" placeholder="缺失、局限和适用范围"/><textarea value="{{reason}}" data-field="reason" bindinput="onField" maxlength="2000" disabled="{{busy || !!pendingId}}" placeholder="后续决定的实际原因"/>
<view wx:if="{{needsPlan}}"><input value="{{title}}" data-field="title" bindinput="onField" maxlength="120" disabled="{{busy || !!pendingId}}" placeholder="后续实际计划标题"/><textarea value="{{instructions}}" data-field="instructions" bindinput="onField" maxlength="4000" disabled="{{busy || !!pendingId}}" placeholder="医生核对后的后续安排"/></view><view wx:if="{{needsDates}}"><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="onField" disabled="{{busy || !!pendingId}}"><view class="note">后续开始：{{startDate}}</view></picker><picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="onField" disabled="{{busy || !!pendingId}}"><view class="note">后续结束：{{endDate}}</view></picker></view><button disabled="{{busy || !!pendingId}}" bindtap="confirmReview">核对并明确确认决定</button></view>
<view wx:for="{{reviews}}" wx:key="id" class="sheet"><text class="title">{{item.decisionLabel}} · {{item.created_at}}</text><text class="note">{{item.professional_confirmation ? '负责医生已确认' : '本人自助决定，未经专业确认'}}</text><text selectable="true">{{item.body}}</text><text class="note">局限：{{item.limitations}}</text><text class="note">原因：{{item.reason}}</text><button wx:if="{{item.next_cycle_id || item.next_assessment_id}}" data-id="{{item.id}}" bindtap="openNext">打开实际后续安排</button></view></view>
