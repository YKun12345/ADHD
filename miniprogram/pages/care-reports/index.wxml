<ui-nav title="评估报告与已发布意见" showBack="{{true}}" fallbackUrl="/pages/home/index" />
<ai-copilot page-key="care-reports" patient-id="{{patientId}}" assessment-id="{{assessmentId}}" />
<view class="review-page product-page product-form-page">
  <view class="sheet"><text class="title">第 {{assessmentId}} 轮的实际发布版本</text><text class="note">自助系统筛查、医生意见和私人草稿分别标明。原始系统结果、意见和局限保留其发布版本。</text><text wx:if="{{errorText}}" class="error">{{errorText}}</text><button disabled="{{loading}}" bindtap="reload">重新读取已发布历史</button></view>
  <view class="sheet"><text wx:if="{{!reports.length && !loading && !errorText}}" class="note">本轮尚无已发布报告。</text><button class="published-report-open" wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" disabled="{{loading}}" bindtap="openReport">{{item.categoryLabel}} · 版本 {{item.version}} · {{item.published_at}}</button></view>
  <view wx:if="{{report}}" class="sheet"><text class="title">{{report.categoryLabel}} · 版本 {{report.version}}</text><text wx:if="{{report.category === 'self_screening'}}" class="note">系统筛查结果，未经医生专业确认 · {{report.published_at}}</text><text wx:else class="note">实际发布医生账号 {{report.actor_user_id}} · {{report.published_at}}</text><text wx:if="{{report.demonstration_only}}" class="note">演示资料，不能用于临床诊断。</text><text selectable="true" class="note">{{report.body}}</text><text selectable="true" class="note">局限与适用范围：{{report.limitations}}</text><text class="note">已冻结输入：{{report.input_digest}}</text><text wx:if="{{report.source_ai_decision_id}}" class="note">医生引用本人已核对的助手草稿（决定 {{report.source_ai_decision_id}}）。模型辅助证据：未准入。</text><text wx:else class="note">AI 草稿：未提供。模型辅助证据：未准入。</text><text class="title">当时的系统原始结果与材料</text><text selectable="true" class="original">{{inputText}}</text></view>
</view>
