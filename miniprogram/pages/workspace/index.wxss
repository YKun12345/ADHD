page { min-height:100%; color:var(--ui-ink); background:var(--ui-page-background); }
.workspace-page { box-sizing:border-box; padding:24rpx 32rpx calc(184rpx + env(safe-area-inset-bottom)); }
.section-intro { margin:0 4rpx 22rpx; }
.section-note { display:block; color:var(--ui-text); font-size:24rpx; line-height:1.7; }
.profile-choice,.profile-card { display:flex; align-items:center; gap:16rpx; padding:18rpx 24rpx; margin:0 0 24rpx; border:1rpx solid rgba(255,255,255,.8); border-radius:var(--ui-radius-md); background:rgba(255,255,255,.76); color:var(--ui-text); font-size:25rpx; line-height:1.6; }
.profile-choice { justify-content:space-between; color:var(--ui-ink); }
.profile-card ui-icon { width:56rpx;height:56rpx;transform:scale(.67);transform-origin:left center;flex:none;margin-right:-18rpx; }
.profile-name { min-width:0;overflow-wrap:anywhere; }
.account-card { display:flex;align-items:center;gap:24rpx;box-sizing:border-box;padding:32rpx 28rpx;margin-bottom:26rpx;min-height:176rpx;border:1rpx solid #fff;border-radius:var(--ui-radius-lg);background:linear-gradient(120deg,#dff3f8,#deedfc);box-shadow:var(--ui-shadow-soft);color:var(--ui-text);font-size:24rpx;line-height:1.65; }
.account-avatar { display:flex;align-items:center;justify-content:center;flex:none;width:100rpx;height:100rpx;border:3rpx solid #fff;border-radius:50%;background:rgba(255,255,255,.6); }
.account-copy { min-width:0;flex:1;overflow-wrap:anywhere; }
.account-copy text { display:block; }
.account-name { color:var(--ui-ink);font-size:33rpx;font-weight:600;margin-bottom:7rpx; }
.entry-list { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx; }
.entry { grid-column:span 2;box-sizing:border-box;min-width:0;padding:27rpx 24rpx;border:1rpx solid rgba(255,255,255,.92);border-radius:var(--ui-radius-lg);background:#fff;box-shadow:var(--ui-shadow-soft);color:var(--ui-ink); }
.entry--tile { grid-column:span 1; }
.entry-main { display:flex;align-items:center;gap:16rpx;min-width:0; }
.entry-icon { flex:none;width:66rpx;height:66rpx;position:relative;overflow:hidden; }
.entry-icon ui-icon { display:block;width:84rpx;height:84rpx;transform:scale(.79);transform-origin:left top; }
.entry-copy { flex:1;min-width:0; }
.entry-title { display:block;font-size:29rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere; }
.entry-note { display:block;margin-top:8rpx;font-size:23rpx;font-weight:400;line-height:1.6;color:var(--ui-text); }
.entry-arrow { flex:none;color:#8099a8;font-size:39rpx;line-height:1; }
.entry--focus { padding:30rpx 24rpx;background:var(--ui-focus);border-color:transparent;color:#fff;box-shadow:var(--ui-shadow-focus); }
.entry--focus .entry-note { color:#e9f7fc; }
.entry--focus .entry-arrow { color:#fff; }
.entry--archive { background:var(--ui-archive);border-color:var(--ui-archive-line); }
.entry--tile .entry-main { flex-wrap:wrap;gap:14rpx; }
.entry--tile .entry-icon { width:58rpx;height:58rpx; }
.entry--tile .entry-icon ui-icon { transform:scale(.69); }
.entry--tile .entry-copy { flex-basis:100%;order:3; }
.entry--tile .entry-arrow { margin-left:auto; }
.entry--tile .entry-title { font-size:28rpx; }
.entry--tile .entry-note { font-size:23rpx; }
.entry-chart { margin-top:24rpx; }
.entry-main ui-data-preview { flex:none; }
.entry-list--account { display:flex;flex-direction:column;gap:0;overflow:hidden;border-radius:var(--ui-radius-lg);background:#fff;box-shadow:var(--ui-shadow-soft); }
.entry-list--account .entry { margin:0 24rpx;padding:25rpx 0;border:0;border-bottom:1rpx solid var(--ui-line);border-radius:0;box-shadow:none;background:transparent; }
.entry-list--account .entry:last-child { border-bottom:0; }
.actual-list { margin-top:28rpx; }
.list-title { display:block;margin:0 4rpx 16rpx;color:var(--ui-ink);font-size:28rpx;font-weight:600; }
.actual-row { display:flex;align-items:center;justify-content:space-between;gap:14rpx;box-sizing:border-box;width:100%;padding:23rpx 24rpx;margin:12rpx 0;border:1rpx solid var(--ui-line);border-radius:var(--ui-radius-md);background:#fff;color:var(--ui-text);font-size:24rpx;line-height:1.65; }
.actual-row>text:last-child { flex:none;color:var(--ui-primary); }
.summary-row { display:flex;flex-wrap:wrap;gap:18rpx;margin:20rpx 4rpx;color:var(--ui-text);font-size:24rpx; }
.logout-button { margin:28rpx 0 0;padding:23rpx;border:0;border-radius:var(--ui-radius-lg);background:#fff;box-shadow:var(--ui-shadow-soft);color:var(--ui-status-unread);font-size:28rpx;font-weight:400; }
.logout-button::after,.error-card button::after { border:0; }
.error-card { padding:24rpx;margin:20rpx 0;border-radius:var(--ui-radius-md);background:#fff3ef;color:#a44e43;font-size:25rpx;line-height:1.6; }
.error-card button { color:#a44e43;background:#fff;font-size:24rpx; }
.state-note { display:block;margin:18rpx 4rpx;font-size:24rpx;line-height:1.7;color:var(--ui-text); }
