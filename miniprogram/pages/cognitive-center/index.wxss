page {
  min-height: 100%;
  background:
    radial-gradient(circle at 8% 0%, rgba(132, 115, 214, 0.2), transparent 31%),
    radial-gradient(circle at 96% 26%, rgba(100, 166, 221, 0.15), transparent 30%),
    linear-gradient(160deg, #fbfaff 0%, #f0edff 54%, #eaf4ff 100%);
}

.cognitive-center-page {
  min-height: 0;
  color: #17324d;
  background: transparent;
}

.center-content {
  box-sizing: border-box;
  padding: 42rpx 32rpx 54rpx;
  padding-bottom: calc(54rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.page-heading {
  display: flex;
  flex-direction: column;
}

.page-kicker {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #5d747d;
  font-size: 24rpx;
}

.summary-card {
  margin-top: 34rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #174d5f 0%, #236b80 68%, #27758a 100%);
  box-shadow: 0 16rpx 40rpx rgba(23, 50, 77, 0.18);
}

.summary-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.summary-title {
  font-size: 31rpx;
  font-weight: 700;
}

.summary-description {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.6;
}

.summary-count {
  flex-shrink: 0;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
}

.summary-progress-track {
  height: 16rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.summary-progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: #73c7b6;
  transition: width 220ms ease;
}

.completion-banner {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  color: #17324d;
  background: #cfe4df;
  font-size: 22rpx;
}

.completion-banner__mark {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  box-sizing: border-box;
  margin-right: 12rpx;
  border: 2rpx solid #2f6f6b;
  border-radius: 50%;
}

.completion-banner__mark::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 7rpx;
  width: 15rpx;
  height: 8rpx;
  border-left: 3rpx solid #2f6f6b;
  border-bottom: 3rpx solid #2f6f6b;
  transform: rotate(-45deg);
}

.test-list {
  margin-top: 28rpx;
}

.battery-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
}

.battery-copy {
  display: flex;
  flex-direction: column;
}

.battery-title {
  font-size: 28rpx;
  font-weight: 700;
}

.battery-description,
.battery-time {
  margin-top: 9rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.55;
}

.battery-button {
  min-height: 84rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #236b80;
  font-size: 25rpx;
}

.test-card {
  min-height: 164rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 14rpx 38rpx rgba(49, 90, 105, 0.075);
  transition: opacity 140ms ease, transform 140ms ease;
}

.test-card--completed {
  border-color: #b8ddd5;
  background: #fbfffe;
}

.test-icon {
  width: 104rpx;
  height: 84rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.test-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.test-title-row {
  display: flex;
  align-items: center;
}

.test-title {
  font-size: 29rpx;
  font-weight: 700;
}

.completed-badge {
  margin-left: 12rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #2f6f6b;
  background: #e5f4f0;
  font-size: 21rpx;
}

.test-description {
  margin-top: 8rpx;
  color: #5d747d;
  font-size: 22rpx;
}

.test-metric {
  margin-top: 9rpx;
  color: #3f7c78;
  font-size: 22rpx;
  font-weight: 600;
}

.test-action {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
  color: #3f7c78;
  font-size: 21rpx;
}

.test-arrow {
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  margin: 12rpx 6rpx 4rpx 0;
  border-top: 3rpx solid #506b75;
  border-right: 3rpx solid #506b75;
  transform: rotate(45deg);
}

.privacy-note {
  display: flex;
  flex-direction: column;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #eaf5f3;
}

.privacy-title {
  color: #2f6f6b;
  font-size: 24rpx;
  font-weight: 700;
}

.privacy-text {
  margin-top: 8rpx;
  color: #506b75;
  font-size: 21rpx;
  line-height: 1.6;
}

@media (prefers-reduced-motion: reduce) {
  .overall-progress-value,
  .test-card {
    transition: none;
  }
}

.medical-tip {
  display: block;
  margin-top: 34rpx;
  color: #5d747d;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
.group-heading { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 6rpx 12rpx; }
.group-title, .group-description { display: block; }
.group-title { color: #173f50; font-size: 29rpx; font-weight: 750; }
.group-description { margin-top: 5rpx; color: #647b85; font-size: 21rpx; }
.group-count { padding: 7rpx 13rpx; border-radius: 999rpx; color: #27758a; background: #e2f1ee; font-size: 21rpx; }
