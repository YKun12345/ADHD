<onboarding-guide role="patient" bind:visibilitychange="onOnboardingVisibilityChange" />
<ai-copilot id="page-companion" wx:if="{{!onboardingVisible}}" page-key="home" bottom-inset="{{60}}" />
<ui-nav title="ADHD智慧辅助" showBack="{{false}}" />
<view class="home-page ui-page ai-copilot-safe-space">
  <view class="welcome-section"><image class="welcome-landscape" src="/assets/product/mist-landscape.png" mode="aspectFit" aria-hidden="{{true}}" /><view class="welcome-copy"><text class="welcome-eyebrow">星仔陪你 · 今天的一小步</text><text class="welcome-text">你好，{{userName}}</text><text class="welcome-subtitle">按照自己的节奏，先完成眼前这一小步</text></view></view>
  <view class="home-bottom-wave" aria-hidden="{{true}}"></view>
  <agent-actions id="home-next-actions" />
  <view class="section-header"><text class="section-title">常用功能</text></view>
  <view class="home-sections glass-surface">
    <view class="home-section" data-section="assessments" bindtap="openSection" aria-role="button"><ui-icon name="scale" shape="line" decorative="{{true}}" /><view><text>继续评估</text><text class="home-section-note">量表、测试与本轮医生意见</text></view><text class="home-section-arrow">›</text></view>
    <view class="home-section" data-section="records" bindtap="openSection" aria-role="button"><ui-icon name="tracking" shape="line" decorative="{{true}}" /><view><text>记录与回顾</text><text class="home-section-note">按真实日期填写，看看自己的变化</text></view><text class="home-section-arrow">›</text></view>
    <view class="home-section" data-section="communication" bindtap="openSection" aria-role="button"><ui-icon name="ai" shape="line" decorative="{{true}}" /><view><text>和医生沟通</text><text class="home-section-note">消息、交办事项与需要补充的问题</text></view><text class="home-section-arrow">›</text></view>
  </view>
  <text class="medical-tip">本平台用于辅助筛查，专业意见和计划由医生确认</text>
</view>
<role-nav id="primary-role-nav" active-key="home" />
