page { min-height:100%;background:var(--ui-page-background);color:var(--ui-ink); }
.home-page.home-page { box-sizing:border-box;padding:28rpx 32rpx calc(184rpx + env(safe-area-inset-bottom)); }
.welcome-section { position:relative;display:flex;align-items:center;min-height:154rpx;padding:4rpx 4rpx 12rpx; }
.welcome-copy { position:relative;z-index:1;min-width:0;flex:1; }
.welcome-landscape { position:absolute;right:-32rpx;top:-12rpx;width:650rpx;height:217rpx;opacity:.72;pointer-events:none; }
.home-bottom-wave { display:none; } /* app.wxss supplies the shared waves. */
.welcome-eyebrow { display:block;color:var(--ui-text);font-size:23rpx;line-height:1.6; }
.welcome-text { display:block;margin-top:14rpx;color:var(--ui-ink);font-size:43rpx;font-weight:650;line-height:1.4;overflow-wrap:anywhere; }
.welcome-subtitle { display:block;margin-top:10rpx;color:var(--ui-text);font-size:24rpx;line-height:1.65; }
.section-header { margin:32rpx 4rpx 18rpx; }
.section-title { color:var(--ui-ink);font-size:30rpx;font-weight:600; }
.home-sections { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;background:transparent;border:0;box-shadow:none;overflow:visible; }
.home-sections::before { display:none; }
.home-section { position:relative;box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;gap:14rpx;min-width:0;padding:25rpx 22rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:var(--ui-radius-lg);background:#fff;box-shadow:var(--ui-shadow-soft);color:var(--ui-ink);font-size:29rpx;font-weight:600;line-height:1.5; }
.home-section ui-icon { flex:none;width:66rpx;height:66rpx;transform:scale(.79);transform-origin:left center;margin-right:-12rpx; }
.home-section>view { width:100%;min-width:0;order:3; }
.home-section text { display:block; }
.home-section .home-section-note { margin-top:9rpx;color:var(--ui-text);font-size:23rpx;font-weight:400;line-height:1.65; }
.home-section .home-section-arrow { margin-left:auto;color:#8ca4b1;font-size:38rpx; }
.home-section:nth-child(3) { grid-column:span 2;flex-wrap:nowrap;background:var(--ui-archive);border-color:var(--ui-archive-line); }
.home-section:nth-child(3)>view { flex:1;order:0;width:auto; }
.medical-tip { display:block;margin-top:28rpx;padding:0 4rpx;color:var(--ui-text);font-size:22rpx;line-height:1.7;text-align:left; }
