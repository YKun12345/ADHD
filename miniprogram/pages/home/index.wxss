page {
  min-height: 100%;
  background: #f4f7fa;
}

.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 32rpx 60rpx;
}

.welcome-section {
  display: flex;
  flex-direction: column;
}

.welcome-text {
  color: #17324d;
  font-size: 44rpx;
  font-weight: 700;
}

.welcome-subtitle {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 27rpx;
}

.progress-card {
  margin-top: 42rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  background: #17324d;
  box-shadow: 0 16rpx 40rpx rgba(23, 50, 77, 0.18);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.progress-number {
  color: #cfe4df;
  font-size: 27rpx;
}

.progress-track {
  height: 18rpx;
  margin-top: 30rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
}

.progress-value {
  width: 0%;
  height: 100%;
  border-radius: 20rpx;
  background: #73c7b6;
}

.progress-tip {
  display: block;
  margin-top: 22rpx;
  color: #d9e5ec;
  font-size: 24rpx;
  line-height: 1.6;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: #17324d;
  font-size: 32rpx;
  font-weight: 700;
}

.section-extra {
  color: #718096;
  font-size: 25rpx;
}

.task-list {
  overflow: hidden;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(23, 50, 77, 0.08);
}

.task-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #edf1f4;
}

.task-item:last-child {
  border-bottom: none;
}

.task-icon,
.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #3f7c78;
  font-weight: 700;
}

.task-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

.task-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.task-title {
  color: #17324d;
  font-size: 29rpx;
  font-weight: 600;
}

.task-description {
  margin-top: 10rpx;
  color: #7a8996;
  font-size: 24rpx;
}

.task-arrow {
  color: #9aa8b5;
  font-size: 48rpx;
}

.quick-header {
  margin-top: 44rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-item {
  width: 48%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(23, 50, 77, 0.07);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.quick-title {
  margin-left: 20rpx;
  color: #17324d;
  font-size: 27rpx;
  font-weight: 600;
}

.medical-tip {
  display: block;
  margin-top: 32rpx;
  text-align: center;
  color: #8795a3;
  font-size: 22rpx;
}