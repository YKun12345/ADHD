page {
  min-height: 100%;
  background-color: #e8f5fb;
  background-image:
    radial-gradient(circle at 8% 0%, rgba(92, 188, 226, 0.2) 0, rgba(92, 188, 226, 0) 32%),
    radial-gradient(circle at 100% 34%, rgba(241, 165, 134, 0.16) 0, rgba(241, 165, 134, 0) 30%),
    linear-gradient(160deg, #f8fcff 0%, #e8f5fb 58%, #fff1e8 100%);
}

.home-page {
  min-height: 0;
  box-sizing: border-box;
  padding: 34rpx 32rpx 58rpx;
  padding-bottom: calc(58rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(58rpx + env(safe-area-inset-bottom));
}

.welcome-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 128rpx;
  padding: 4rpx 6rpx 0;
}

.welcome-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.welcome-eyebrow {
  color: #236b80;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.welcome-text {
  max-width: 480rpx;
  margin-top: 9rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #173f50;
  font-size: 45rpx;
  font-weight: 750;
  line-height: 1.25;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.welcome-subtitle {
  margin-top: 12rpx;
  color: #5d747d;
  font-size: 25rpx;
  line-height: 1.55;
}

.progress-card {
  margin-top: 36rpx;
  padding: 38rpx 36rpx 34rpx;
  border-color: rgba(255, 255, 255, 0.28);
  border-radius: 34rpx;
  background:
    radial-gradient(circle at 92% 0%, rgba(80, 190, 224, 0.3) 0, rgba(80, 190, 224, 0) 36%),
    radial-gradient(circle at 78% 100%, rgba(115, 103, 217, 0.2) 0, rgba(115, 103, 217, 0) 32%),
    linear-gradient(145deg, #174d5f 0%, #1d6677 62%, #28798b 100%);
  box-shadow: 0 24rpx 58rpx rgba(28, 94, 111, 0.22);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-title {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.progress-number {
  color: #f5fbfc;
  font-size: 28rpx;
  font-weight: 650;
}

.progress-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.dashboard-source {
  height: 40rpx;
  margin-top: 9rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  color: #e8f7f8;
  background: rgba(255, 255, 255, 0.12);
  font-size: 21rpx;
}

.progress-track {
  height: 16rpx;
  margin-top: 34rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  background: rgba(238, 249, 251, 0.18);
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #73d4c0 0%, #6ed4e7 72%, #b0a8ff 100%);
  box-shadow: 0 0 18rpx rgba(110, 212, 231, 0.42);
  transition: width 240ms ease;
}

.progress-tip {
  display: block;
  margin-top: 23rpx;
  color: rgba(241, 250, 251, 0.86);
  font-size: 23rpx;
  line-height: 1.65;
}

.dashboard-message {
  display: block;
  margin-top: 14rpx;
  color: #f6dfb7;
  font-size: 22rpx;
  line-height: 1.55;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 48rpx 4rpx 20rpx;
}

.section-title {
  color: #173f50;
  font-size: 31rpx;
  font-weight: 700;
}

.section-extra {
  color: #5d747d;
  font-size: 23rpx;
}

.task-list {
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.08);
}

.task-item {
  position: relative;
  min-height: 126rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  transition: background-color 140ms ease, opacity 140ms ease;
}

.task-item + .task-item {
  border-top: 1rpx solid rgba(215, 231, 235, 0.86);
}

.task-item--pressed {
  background: rgba(226, 243, 247, 0.7);
}

.task-item--disabled,
.quick-item--disabled {
  opacity: 0.56;
}

.task-icon,
.quick-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-icon {
  width: 84rpx;
  height: 84rpx;
}

.task-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.task-title {
  color: #173f50;
  font-size: 28rpx;
  font-weight: 650;
}

.task-description {
  margin-top: 8rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.45;
}

.task-tail {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 14rpx;
}

.task-status,
.entry-status {
  color: #5d747d;
  font-size: 21rpx;
}

.task-arrow {
  width: 13rpx;
  height: 13rpx;
  margin-left: 12rpx;
  border-top: 2rpx solid #5d747d;
  border-right: 2rpx solid #5d747d;
  transform: rotate(45deg);
}

.quick-header {
  margin-top: 46rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
  padding: 4rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.075);
}

.quick-item {
  position: relative;
  width: 50%;
  min-height: 166rpx;
  box-sizing: border-box;
  padding: 24rpx 18rpx 22rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  transition: background-color 140ms ease, opacity 140ms ease, transform 140ms ease;
}

.quick-item--pressed {
  background: rgba(228, 244, 248, 0.74);
  transform: scale(0.985);
}

.quick-icon {
  width: 76rpx;
  height: 76rpx;
}

.quick-content {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 15rpx;
}

.care-badge { position: absolute; top: 16rpx; right: 18rpx; min-width: 34rpx; height: 34rpx; box-sizing: border-box; padding: 0 9rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; color: #fff; background: #c95f5f; font-size: 21rpx; font-weight: 700; }

.quick-title {
  color: #173f50;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.4;
}

.entry-status {
  margin-top: 7rpx;
}

.medical-tip {
  display: block;
  margin-top: 36rpx;
  padding: 0 28rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.footer-actions {
  min-height: 88rpx;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-settings-entry,
.server-settings-entry {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 25rpx;
  color: #506b75;
  font-size: 23rpx;
  transition: opacity 140ms ease;
}

.footer-separator {
  width: 1rpx;
  height: 26rpx;
  background: #cadde2;
}

.footer-entry--pressed {
  opacity: 0.5;
}

@media (prefers-reduced-motion: reduce) {
  .progress-value,
  .task-item,
  .quick-item,
  .privacy-settings-entry,
  .server-settings-entry {
    transition: none;
  }
}
