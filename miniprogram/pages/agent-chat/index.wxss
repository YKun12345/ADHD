page{background:#f1f8fa;color:#284653;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.chat-page{padding:12rpx 26rpx calc(390rpx + env(safe-area-inset-bottom));box-sizing:border-box;min-height:80vh}
.chat-presence{display:flex;align-items:center;justify-content:center;gap:10rpx;min-height:50rpx;margin-bottom:22rpx;color:#73908f;font-size:23rpx}
.presence-dot{width:11rpx;height:11rpx;background:#69afa0;border-radius:50%}
.conversation{max-width:960rpx;margin:0 auto}.message{display:flex;align-items:flex-start;gap:14rpx;margin:22rpx 0}.message--user{justify-content:flex-end;margin:26rpx 0 14rpx 60rpx}
.pet-avatar{flex:none;width:88rpx;height:88rpx;display:flex;align-items:center;justify-content:center}.small-avatar{width:64rpx;height:64rpx;flex:none;display:flex;align-items:center;justify-content:center}
.pet-avatar ai-mascot{width:88rpx;height:88rpx}.small-avatar ai-mascot{width:60rpx;height:60rpx}
.bubble{box-sizing:border-box;min-width:0;padding:23rpx 25rpx;font-size:28rpx;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere;border-radius:24rpx;max-width:calc(100% - 80rpx)}
.bubble--assistant{flex:1;background:#fff;border:1rpx solid #e2edef;border-top-left-radius:7rpx;box-shadow:0 5rpx 18rpx rgba(43,92,102,.025)}
.bubble--user{color:#245d63;background:#dcefed;border-top-right-radius:7rpx;max-width:90%}.welcome-message .bubble{max-width:calc(100% - 100rpx)}
.pet-response{display:block;margin-top:14rpx;color:#42887e}.quiet-text,.summary-text{display:block;color:#759096;font-size:24rpx;line-height:1.7;margin-top:12rpx}.working-text{color:#618c89}
.starter-prompts{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0 26rpx 100rpx}.prompt-button{margin:0;padding:11rpx 19rpx;font-size:24rpx;color:#4f8582;background:#e5f2f0;border-radius:24rpx;line-height:1.6;font-weight:400}
button::after{border:0}button[disabled]{opacity:.52}.text-button,.details-toggle{margin:0;padding:10rpx 0;color:#608f91;font-size:24rpx;line-height:1.6;background:transparent;font-weight:400;border-radius:12rpx;text-align:left}
.details-toggle{display:block;margin-top:12rpx;font-size:22rpx;color:#8b9fa4}.earlier-button{margin:0 auto;text-align:center}
.next-step-intro{display:block;font-size:25rpx;color:#6c9290}.next-step-title{display:block;margin-top:6rpx;color:#315d64;font-size:29rpx;font-weight:600}
.service-label{display:block;margin:0 0 18rpx;text-align:center;font-size:23rpx;color:#60818b;line-height:1.6}
.business-reminder{margin:32rpx 0 24rpx;padding:24rpx;border:1rpx solid #d5e4e7;border-radius:20rpx;background:#eaf3f5}
.reminder-caption{display:block;margin-top:8rpx;color:#758e97;font-size:22rpx;line-height:1.6}
.action-button{margin:18rpx 0 0;padding:14rpx 22rpx;border-radius:18rpx;color:#fff;background:#398e91;font-size:26rpx;font-weight:500;line-height:1.7;box-shadow:0 5rpx 12rpx rgba(57,142,145,.1)}
.answer-details{margin-top:10rpx;padding-top:14rpx;border-top:1rpx solid #edf1f2;color:#8b9da3;font-size:22rpx;line-height:1.7}.answer-details text{display:block;margin-bottom:10rpx}
.chat-tools{margin:0 0 20rpx;padding:22rpx 26rpx;border:1rpx solid #dbe9e9;border-radius:22rpx;background:#fff}.tools-title{display:block;color:#467a7a;font-size:26rpx;font-weight:600}.tool-choice{padding:16rpx 0;font-size:25rpx;color:#5d7d83;border-bottom:1rpx solid #edf2f3}.tool-row{display:flex;gap:30rpx;margin-top:12rpx}
.writing-preview{margin-top:18rpx;padding:16rpx 18rpx;background:#f3f8f8;border-radius:14rpx;font-size:25rpx;line-height:1.8}.writing-title{display:block;font-size:28rpx;font-weight:600;margin-bottom:12rpx}.writing-preview text{display:block}
.writing-sheet{margin:20rpx 0 20rpx 78rpx;padding:24rpx;background:#fff;border:1rpx solid #deebeb;border-radius:22rpx;font-size:26rpx;line-height:1.8}
.writing-input,.writing-textarea,.writing-reason{width:100%;box-sizing:border-box;padding:18rpx;margin-top:16rpx;border:1rpx solid #dfebeb;border-radius:14rpx;background:#f7fbfb;font-size:26rpx;color:#31535d}.writing-input{height:78rpx}.writing-textarea{min-height:220rpx}.writing-reason{min-height:130rpx}
.delivery-note{margin:24rpx 0;padding:18rpx 24rpx;background:#f7f4e8;border-radius:18rpx;color:#8a8055;font-size:24rpx;line-height:1.7}.delivery-note button{display:inline-block;margin-right:26rpx}
.quiet-notice,.error-notice{display:block;margin:18rpx 10rpx;color:#799298;font-size:24rpx;line-height:1.7}.error-notice{color:#b16a62}
.composer{position:fixed;left:0;right:0;z-index:35;box-sizing:border-box;padding:18rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));background:rgba(249,253,253,.98);border-top:1rpx solid #e0ecee}
.composer-pet{display:flex;align-items:center;gap:18rpx;max-width:960rpx;min-height:112rpx;margin:0 auto 14rpx}.composer-pet-avatar{width:112rpx;height:112rpx;flex:none;overflow:visible}.composer-pet-avatar ai-mascot{display:block;width:112rpx;height:112rpx}.composer-pet-copy{flex:1;min-width:0}.composer-pet-name{display:block;color:#4a7a7a;font-size:25rpx;font-weight:500}.composer-pet-status{display:block;color:#789795;font-size:22rpx;line-height:1.6;margin-top:5rpx;overflow-wrap:anywhere}.pet-touch-button{flex:0 0 150rpx;width:150rpx;min-width:0;box-sizing:border-box;margin:0;padding:12rpx 18rpx;line-height:1.6;font-size:23rpx;font-weight:400;color:#477f7b;background:#e5f2ed;border-radius:22rpx}
.composer-row{display:flex;align-items:flex-end;gap:16rpx;max-width:960rpx;margin:0 auto}.composer-input{display:block;flex:1;width:0;min-width:0;box-sizing:border-box;min-height:82rpx;max-height:190rpx;padding:20rpx 22rpx;border:1rpx solid #dce9e9;border-radius:22rpx;background:#fff;color:#31565d;font-size:27rpx;line-height:1.6}
.send-button{flex:0 0 112rpx;width:112rpx;box-sizing:border-box;margin:0;min-width:112rpx;height:82rpx;display:flex;align-items:center;justify-content:center;padding:0 16rpx;border-radius:22rpx;background:#398e91;color:#fff;font-size:26rpx;font-weight:500;line-height:1}.send-button[disabled]{background:#d9e9e8;color:#729594;opacity:1}
.composer-caption{display:block;margin-top:10rpx;text-align:center;color:#91a7aa;font-size:20rpx}.composer-mode{display:block;margin:0 0 12rpx;color:#628a8d;font-size:23rpx}
.composer-options{display:flex;justify-content:space-between;align-items:center;max-width:960rpx;margin:8rpx auto 0}.composer-options .composer-caption{margin:0}.smart-button{margin:0;padding:5rpx 8rpx;background:transparent;color:#558d8b;font-size:22rpx;font-weight:400;line-height:1.6;border-radius:10rpx}
.context-choice{display:block;width:100%;margin:12rpx 0;padding:14rpx 18rpx;background:#f0f7f6;color:#547b7e;font-size:24rpx;line-height:1.6;text-align:left;border-radius:14rpx;font-weight:400;white-space:normal}.context-choice--selected{background:#dbeee8;color:#28776d}.business-shortcuts{max-width:960rpx;margin:0 auto 10rpx;display:flex;justify-content:flex-start}.business-shortcuts .smart-button{background:#e5f2ed;padding:9rpx 18rpx;border-radius:18rpx}.smart-preview{margin-left:0}.smart-preview text{display:block;white-space:pre-wrap;overflow-wrap:anywhere}

@import "../../styles/product-page.wxss";
page { color: var(--ui-ink); background: var(--ui-page-background); }
