page { min-height: 100%; color: #17324d; background: #f2f7f8; }
.settings-page { min-height: 0; box-sizing: border-box; padding: 36rpx 30rpx 64rpx; padding-bottom: calc(64rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 92% 0%, rgba(132,204,211,.18), transparent 32%), linear-gradient(180deg, #f8fbfc, #eef4f6); }
.settings-header { display: flex; align-items: center; margin: 2rpx 4rpx 26rpx; }
.settings-header__mark { width: 88rpx; height: 88rpx; flex: none; overflow: hidden; border-radius: 50%; }
.settings-header__copy { min-width: 0; margin-left: 20rpx; }
.settings-title, .settings-subtitle, .environment-title, .environment-address, .field-label, .field-help, .notice-title { display: block; }
.settings-title { font-size: 40rpx; font-weight: 700; }
.settings-subtitle { margin-top: 8rpx; color: #506b75; font-size: 23rpx; line-height: 1.55; }
.settings-card { padding: 28rpx; border: 1rpx solid rgba(255,255,255,.92); border-radius: 34rpx; background: rgba(255,255,255,.78); box-shadow: 0 16rpx 44rpx rgba(36,79,93,.09); }
.environment-card { display: flex; align-items: center; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 1rpx solid #dbe7e9; }
.environment-card > view { min-width: 0; flex: 1; }
.environment-title, .field-label, .notice-title { font-size: 26rpx; font-weight: 700; }
.environment-address { margin-top: 8rpx; word-break: break-all; overflow-wrap: anywhere; color: #506b75; font-size: 21rpx; line-height: 1.45; }
.environment-badge { flex: none; flex-shrink: 0; margin-left: 18rpx; padding: 9rpx 16rpx; border: 1rpx solid #bdd9d4; border-radius: 999rpx; color: #245f59; background: #e9f4f1; font-size: 21rpx; font-weight: 600; }
.settings-form { padding-top: 24rpx; }
.address-input { width: 100%; min-height: 88rpx; box-sizing: border-box; margin-top: 16rpx; padding: 0 22rpx; border: 1rpx solid #c6d8dd; border-radius: 20rpx; color: #17324d; background: #f6fafb; font-size: 25rpx; }
.input-placeholder { color: #5d747d; }
.field-help { margin-top: 13rpx; color: #506b75; font-size: 21rpx; line-height: 1.65; }
.test-button, .reset-button { min-height: 88rpx; font-size: 24rpx; }
.test-button { margin-top: 26rpx; }
.reset-button { margin-top: 14rpx; }
.status-message { min-height: 64rpx; display: flex; align-items: center; box-sizing: border-box; margin-top: 16rpx; padding: 14rpx 18rpx; border-radius: 18rpx; font-size: 22rpx; line-height: 1.55; }
.status-mark { position: relative; width: 34rpx; height: 34rpx; flex: none; margin-right: 14rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.status-mark--success::after { content: ''; position: absolute; top: 8rpx; left: 7rpx; width: 15rpx; height: 8rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }
.status-mark--error::before, .status-mark--error::after { content: ''; position: absolute; top: 15rpx; left: 7rpx; width: 18rpx; height: 3rpx; background: currentColor; transform: rotate(45deg); }
.status-mark--error::after { transform: rotate(-45deg); }
.status-message--success { color: #256b62; background: #e7f3ef; }
.status-message--error { color: #a43f3f; background: #fff0f0; }
.notice-card { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid #d9e5e7; border-radius: 26rpx; background: rgba(244,249,250,.8); }
.notice-item { display: flex; align-items: flex-start; margin-top: 14rpx; color: #506b75; font-size: 21rpx; line-height: 1.65; }
.notice-item + .notice-item { margin-top: 14rpx; }
.notice-item__mark { width: 10rpx; height: 10rpx; flex: none; margin: 14rpx 14rpx 0 0; border: 3rpx solid #4c8990; border-radius: 50%; }
.back-link { min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 14rpx; border-radius: 20rpx; color: #245f68; font-size: 23rpx; font-weight: 600; }
.settings-control--pressed { opacity: .75; background: #e8f2f3; }
