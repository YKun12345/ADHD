page { min-height: 100%; color: #17324d; background: #fff6df; }
.education-page { min-height: 0; box-sizing: border-box; padding: 34rpx 28rpx 60rpx; padding-bottom: calc(60rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 92% 0%, rgba(244,190,126,.24), transparent 34%), linear-gradient(160deg, #fffdf7, #fff6df 54%, #fff0dc); }
.education-header { display: flex; align-items: center; margin: 4rpx 4rpx 28rpx; padding: 28rpx; border: 1rpx solid #fff4e5; border-radius: 34rpx; background: linear-gradient(135deg, #fff9f1, #eef8f8); box-shadow: 0 16rpx 42rpx rgba(85,76,58,.08); }
.education-header__mark { width: 88rpx; height: 88rpx; flex: none; overflow: hidden; border-radius: 20rpx 30rpx 30rpx 20rpx; }
.education-header__copy { min-width: 0; margin-left: 20rpx; }
.education-header__title, .education-header__subtitle, .offline-badge, .article-card__title, .article-card__summary, .source-note text { display: block; }
.education-header__title { font-size: 38rpx; font-weight: 700; }
.education-header__subtitle { margin-top: 8rpx; color: #506b75; font-size: 23rpx; line-height: 1.5; }
.offline-badge { display: inline-flex; margin-top: 13rpx; padding: 8rpx 14rpx; border: 1rpx solid #c9dfdc; border-radius: 999rpx; color: #2f6962; background: #eaf4f1; font-size: 21rpx; }
.category-tabs { width: 100%; white-space: nowrap; }
.category-tab { min-height: 88rpx; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; margin-right: 12rpx; padding: 0 24rpx; border: 1rpx solid #d3e1e3; border-radius: 999rpx; color: #506b75; background: rgba(255,255,255,.74); font-size: 23rpx; }
.category-tab--active { border-color: #4b8c91; color: #205f6c; background: #dfeff0; font-weight: 700; box-shadow: inset 0 0 0 1rpx #aacdd1; }
.category-tab--idle { color: #506b75; }
.article-list { margin-top: 22rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.92); border-radius: 34rpx; background: rgba(255,255,255,.76); box-shadow: 0 16rpx 44rpx rgba(36,79,93,.08); }
.article-card { min-height: 168rpx; box-sizing: border-box; padding: 26rpx; border-bottom: 1rpx solid #dce7e9; }
.article-card:last-child { border-bottom: 0; }
.article-card__top { display: flex; align-items: flex-start; }
.article-card__icon { width: 84rpx; height: 84rpx; flex: none; overflow: hidden; }
.article-card__title { min-width: 0; flex: 1; margin-left: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.article-card__chevron { width: 18rpx; height: 18rpx; flex: none; margin: 11rpx 7rpx 0 18rpx; border-top: 3rpx solid #67808a; border-right: 3rpx solid #67808a; transform: rotate(45deg); }
.article-card__summary { margin-top: 13rpx; color: #506b75; font-size: 23rpx; line-height: 1.65; }
.article-card__meta { display: flex; justify-content: space-between; margin-top: 18rpx; color: #5d747d; font-size: 21rpx; }
.article-card__meta text + text { margin-left: 18rpx; }
.article-empty { padding: 58rpx 28rpx; color: #506b75; text-align: center; }
.article-empty__title, .article-empty__text { display: block; }
.article-empty__title { color: #294d59; font-size: 27rpx; font-weight: 700; }
.article-empty__text { margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; }
.education-control--pressed { opacity: .76; background: #edf5f5; }
.source-note { margin-top: 22rpx; padding: 24rpx; border: 1rpx solid #e6d8c5; border-radius: 24rpx; color: #506b75; background: rgba(255,248,238,.78); font-size: 22rpx; line-height: 1.65; }
.source-note__title { margin-bottom: 8rpx; color: #5e4c38; font-size: 25rpx; font-weight: 700; }
.medical-tip { display: block; margin-top: 22rpx; color: #506b75; font-size: 21rpx; line-height: 1.6; text-align: center; }
