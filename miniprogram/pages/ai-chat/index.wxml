<view class="chat-shell">
  <ui-nav title="AI 健康助手" rightText="清空" bind:righttap="clearConversation" />

  <view class="chat-page">
    <view class="chat-notice" aria-role="note">
      <text class="chat-notice__label">安全提示</text>
      <text class="chat-notice__text">{{lastDisclaimer}} 请勿发送身份证号、联系方式等敏感信息。</text>
      <text wx:if="{{childNotice}}" class="chat-notice__child">儿童患者建议由监护人陪同使用。</text>
    </view>

    <scroll-view
      class="message-list"
      scroll-y="true"
      scroll-with-animation="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
      aria-live="polite"
    >
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="message-row message-row--{{item.role}}"
      >
        <view wx:if="{{item.role !== 'user'}}" class="message-avatar message-avatar--assistant">
          <view class="message-avatar__mascot">
            <ai-mascot state="{{item.role === 'assistant' ? 'happy' : 'idle'}}" label="AI助手星仔" decorative="{{false}}" />
          </view>
        </view>

        <view class="message-bubble message-bubble--{{item.role}}">
          <view wx:if="{{item.role !== 'user'}}" class="message-bubble__header">
            <text>{{item.role === 'assistant' ? 'AI助手' : '使用引导'}}</text>
            <text wx:if="{{item.degraded}}" class="degraded-badge">本地辅助回答</text>
          </view>
          <text class="message-content" user-select="true">{{item.content}}</text>

          <view wx:if="{{item.usedContext.length}}" class="used-context">
            <text class="used-context__label">本次参考：</text>
            <text
              wx:for="{{item.usedContext}}"
              wx:for-item="contextItem"
              wx:key="*this"
              class="used-context__item"
            >{{contextItem}}</text>
          </view>

          <text wx:if="{{item.role === 'user' && item.status === 'sending'}}" class="message-status">发送中…</text>
          <view wx:if="{{item.role === 'user' && item.status === 'failed'}}" class="message-failed">
            <text>发送失败</text>
            <view
              class="retry-button"
              hover-class="chat-control--pressed"
              data-id="{{item.id}}"
              bindtap="retryMessage"
              aria-role="button"
            >重新发送</view>
          </view>
        </view>
      </view>

      <view wx:if="{{sending}}" class="assistant-thinking" aria-role="status" aria-live="polite">
        <view class="assistant-thinking__mascot">
          <ai-mascot state="thinking" decorative="{{true}}" />
        </view>
        <view class="thinking-dot"></view>
        <view class="thinking-dot"></view>
        <view class="thinking-dot"></view>
        <text>正在生成回答…</text>
      </view>

      <text wx:if="{{statusMessage}}" class="status-message" aria-role="status" aria-live="assertive">{{statusMessage}}</text>
      <view id="chat-bottom" class="chat-bottom"></view>
    </scroll-view>

    <view class="chat-workspace">
      <scroll-view
        wx:if="{{messages.length === 1}}"
        class="quick-prompts"
        scroll-x="true"
        enable-flex="true"
        show-scrollbar="{{false}}"
        aria-label="快捷问题"
      >
        <view
          wx:for="{{suggestions}}"
          wx:key="id"
          class="quick-prompt"
          hover-class="chat-control--pressed"
          data-id="{{item.id}}"
          bindtap="applySuggestion"
          aria-role="button"
          aria-label="{{item.text}}"
        >
          <text class="quick-prompt__spark">＋</text>
          <text class="quick-prompt__label">{{item.label}}</text>
        </view>
      </scroll-view>

      <scroll-view
        class="context-tools"
        scroll-x="true"
        enable-flex="true"
        show-scrollbar="{{false}}"
        aria-role="radiogroup"
        aria-label="咨询方向"
      >
        <view
          wx:for="{{contexts}}"
          wx:key="id"
          class="context-pill context-pill--{{contextScope === item.id ? 'active' : 'idle'}}"
          hover-class="chat-control--pressed"
          data-scope="{{item.id}}"
          bindtap="selectScope"
          aria-role="radio"
          aria-label="{{item.label}}，{{item.description}}"
          aria-checked="{{contextScope === item.id}}"
        >{{item.label}}</view>
      </scroll-view>

      <view class="composer">
        <view class="composer__main">
          <textarea
            class="message-input"
            value="{{inputValue}}"
            maxlength="{{maxMessageLength}}"
            placeholder="可以询问健康问题或小程序使用方法"
            auto-height="true"
            cursor-spacing="24"
            confirm-type="send"
            bindinput="handleInput"
            bindfocus="handleInputFocus"
            bindblur="handleInputBlur"
            bindconfirm="handleSend"
          ></textarea>

          <view class="composer__actions">
            <text wx:if="{{showInputCount}}" class="input-count">{{inputLength}}/{{maxMessageLength}}</text>
            <view
              class="send-button send-button--{{sending ? 'disabled' : 'active'}}"
              hover-class="{{sending ? 'none' : 'send-button--pressed'}}"
              aria-role="button"
              aria-disabled="{{sending}}"
              bindtap="handleSend"
            >{{sending ? '发送中' : '发送'}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
