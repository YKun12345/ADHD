page {
  height: 100%;
  min-height: 100%;
  color: #173f50;
  background-color: #f5efff;
  background-image:
    radial-gradient(circle at 6% 0%, rgba(151, 126, 216, 0.18) 0, rgba(151, 126, 216, 0) 30%),
    radial-gradient(circle at 100% 40%, rgba(103, 176, 221, 0.13) 0, rgba(103, 176, 221, 0) 28%),
    linear-gradient(160deg, #fcfaff 0%, #f5efff 56%, #eef7ff 100%);
}

.chat-shell {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-page {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-notice {
  margin: 14rpx 32rpx 0;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  box-sizing: border-box;
  border: 1rpx solid rgba(173, 213, 219, 0.72);
  border-radius: 16rpx;
  color: #506b75;
  background: rgba(235, 248, 249, 0.7);
  font-size: 21rpx;
  line-height: 1.48;
}

.chat-notice__label {
  flex: none;
  margin-right: 12rpx;
  color: #236b80;
  font-weight: 700;
}

.chat-notice__text {
  min-width: 0;
  flex: 1;
}

.chat-notice__child {
  width: 100%;
  margin-top: 6rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid rgba(224, 164, 91, 0.28);
  color: #735729;
}

.message-list {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
  padding: 34rpx 32rpx 18rpx;
  box-sizing: border-box;
  background: transparent;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.message-row--guide,
.message-row--assistant {
  justify-content: flex-start;
}

.message-row--user {
  justify-content: flex-end;
}

.message-avatar {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(49, 90, 105, 0.1);
}

.message-avatar--assistant {
  margin-right: 14rpx;
  background: linear-gradient(145deg, #effaf7, #dff2ed);
}

.message-avatar__mascot {
  width: 50rpx;
  height: 50rpx;
  flex: 0 0 50rpx;
}

.message-bubble {
  max-width: calc(100% - 68rpx);
  box-sizing: border-box;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.68;
  word-break: break-word;
}

.message-bubble--guide,
.message-bubble--assistant {
  padding: 8rpx 4rpx 8rpx 0;
  color: #173f50;
  background: transparent;
}

.message-bubble--user {
  max-width: 78%;
  padding: 20rpx 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #236b80 0%, #27758a 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 107, 128, 0.14);
}

.message-bubble__header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
  color: #506b75;
  font-size: 21rpx;
  font-weight: 650;
}

.degraded-badge {
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #735729;
  background: #fff1cf;
  font-size: 21rpx;
}

.message-content,
.message-status,
.quick-prompt__label {
  display: block;
}

.message-content {
  white-space: pre-wrap;
}

.used-context {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
  font-size: 21rpx;
}

.used-context__label {
  margin-right: 8rpx;
  color: #506b75;
}

.used-context__item {
  margin: 4rpx 8rpx 4rpx 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #236b80;
  background: rgba(255, 255, 255, 0.72);
}

.message-status {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 21rpx;
  text-align: right;
}

.message-failed {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 21rpx;
}

.retry-button {
  min-width: 124rpx;
  min-height: 88rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  color: #ffffff;
}

.assistant-thinking {
  display: inline-flex;
  align-items: center;
  margin: 0 0 22rpx 68rpx;
  color: #506b75;
  font-size: 21rpx;
}

.assistant-thinking__mascot {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  margin-right: 12rpx;
}

.thinking-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #318ca6;
  animation: thinking 900ms ease-in-out infinite;
}

.thinking-dot:nth-child(2) {
  animation-delay: 150ms;
}

.thinking-dot:nth-child(3) {
  animation-delay: 300ms;
}

.assistant-thinking text {
  margin-left: 4rpx;
}

@keyframes thinking {
  0%, 100% {
    opacity: 0.38;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-5rpx);
  }
}

.status-message {
  display: block;
  margin: 12rpx 0 20rpx 68rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  color: #963f38;
  background: #fff0ed;
  font-size: 21rpx;
  line-height: 1.5;
}

.chat-bottom {
  height: 2rpx;
}

.chat-workspace {
  position: relative;
  z-index: 4;
  flex: none;
  padding: 10rpx 24rpx 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 239, 255, 0) 0%, rgba(245, 239, 255, 0.92) 18%, #f5efff 44%);
}

.quick-prompts,
.context-tools {
  width: 100%;
  display: flex;
  white-space: nowrap;
}

.quick-prompts {
  margin-bottom: 12rpx;
}

.quick-prompt,
.context-pill {
  flex: none;
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(199, 221, 227, 0.94);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  transition: opacity 140ms ease, transform 140ms ease;
}

.quick-prompt {
  min-width: 184rpx;
  padding: 0 22rpx;
  color: #244c5b;
}

.quick-prompt + .quick-prompt,
.context-pill + .context-pill {
  margin-left: 12rpx;
}

.quick-prompt__spark {
  margin-right: 8rpx;
  color: #318ca6;
  font-size: 27rpx;
  line-height: 1;
}

.quick-prompt__label {
  font-size: 23rpx;
  font-weight: 600;
}

.context-tools {
  margin-bottom: 12rpx;
}

.context-pill {
  min-width: 160rpx;
  padding: 0 22rpx;
  color: #506b75;
  font-size: 22rpx;
}

.context-pill--active {
  border-color: rgba(49, 140, 166, 0.68);
  color: #236b80;
  background: linear-gradient(145deg, rgba(227, 246, 249, 0.94), rgba(239, 246, 255, 0.88));
  font-weight: 650;
}

.composer {
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 38rpx rgba(49, 90, 105, 0.12);
}

.composer__main {
  min-height: 104rpx;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 8rpx 8rpx 8rpx 20rpx;
  border: 1rpx solid rgba(199, 221, 227, 0.82);
  border-radius: 24rpx;
  background: rgba(243, 249, 251, 0.84);
}

.message-input {
  width: 0;
  min-width: 0;
  min-height: 88rpx;
  max-height: 220rpx;
  flex: 1;
  box-sizing: border-box;
  padding: 20rpx 8rpx 16rpx 0;
  color: #173f50;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.5;
}

.composer__actions {
  flex: none;
  display: flex;
  align-items: center;
}

.input-count {
  margin-right: 10rpx;
  color: #5d747d;
  font-size: 21rpx;
}

.send-button {
  min-width: 112rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #236b80 0%, #27758a 100%);
  font-size: 23rpx;
  font-weight: 650;
  box-shadow: 0 8rpx 20rpx rgba(35, 107, 128, 0.16);
  transition: opacity 140ms ease, transform 140ms ease;
}

.send-button--pressed,
.chat-control--pressed {
  opacity: 0.76;
  transform: scale(0.985);
}

.send-button--disabled {
  opacity: 0.58;
  box-shadow: none;
}

@media (prefers-reduced-motion: reduce) {
  .thinking-dot {
    animation: none;
  }

  .quick-prompt,
  .context-pill,
  .send-button {
    transition: none;
  }

  .send-button--pressed,
  .chat-control--pressed {
    transform: none;
  }
}
