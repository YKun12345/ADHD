page {
  height: 100%;
  min-height: 100%;
  color: #173f50;
  background-color: #f2f8fa;
  background-image:
    radial-gradient(circle at 6% 0%, rgba(80, 190, 224, 0.15) 0, rgba(80, 190, 224, 0) 30%),
    radial-gradient(circle at 100% 40%, rgba(115, 103, 217, 0.06) 0, rgba(115, 103, 217, 0) 28%),
    linear-gradient(160deg, #f9fcfd 0%, #f1f8fa 60%, #edf5f7 100%);
}

.chat-shell {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-page {
  min-height: 0;
  flex: 1;
  box-sizing: border-box;
  padding: 18rpx 28rpx 48rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.safety-banner,
.child-notice {
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  font-size: 23rpx;
  line-height: 1.68;
}

.safety-banner {
  border: 1rpx solid rgba(173, 213, 219, 0.84);
  color: #506b75;
  background: linear-gradient(145deg, rgba(235, 248, 249, 0.9), rgba(245, 250, 252, 0.82));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.safety-banner text,
.context-section__label,
.context-tab__label,
.context-tab__description,
.message-content,
.message-status,
.suggestion-section__title,
.suggestion-item__label,
.suggestion-item__text,
.medical-disclaimer text {
  display: block;
}

.safety-banner__title {
  margin-bottom: 6rpx;
  color: #236b80;
  font-weight: 700;
}

.child-notice {
  margin-top: 14rpx;
  border: 1rpx solid rgba(224, 164, 91, 0.28);
  color: #735729;
  background: rgba(255, 248, 233, 0.88);
}

.context-section {
  margin-top: 24rpx;
}

.context-section__label,
.suggestion-section__title {
  margin: 0 4rpx 14rpx;
  color: #244c5b;
  font-size: 25rpx;
  font-weight: 650;
}

.context-tabs {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.context-tab {
  width: calc(33.333% - 12rpx);
  min-width: 0;
  min-height: 104rpx;
  margin: 6rpx;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(199, 221, 227, 0.94);
  border-radius: 21rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  transition: opacity 140ms ease, transform 140ms ease;
}

.context-tab--active {
  border-color: rgba(49, 140, 166, 0.68);
  color: #236b80;
  background: linear-gradient(145deg, rgba(227, 246, 249, 0.94), rgba(239, 246, 255, 0.88));
  box-shadow: 0 8rpx 22rpx rgba(49, 140, 166, 0.08);
}

.context-tab--idle {
  color: #506b75;
}

.context-tab__label {
  font-size: 24rpx;
  font-weight: 650;
}

.context-tab__description {
  margin-top: 6rpx;
  overflow: hidden;
  color: #5d747d;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-list {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
  margin-top: 24rpx;
  padding: 28rpx 22rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow:
    0 18rpx 48rpx rgba(49, 90, 105, 0.07),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94);
}

.message-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 26rpx;
}

.message-row--guide,
.message-row--assistant {
  justify-content: flex-start;
}

.message-row--user {
  justify-content: flex-end;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow: 0 8rpx 18rpx rgba(49, 90, 105, 0.12);
}

.message-avatar--assistant {
  margin-right: 14rpx;
  background: #236b80;
}

.message-avatar__icon-scale {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 84rpx;
  transform: scale(0.72);
}

.message-avatar--user {
  margin-left: 14rpx;
  color: #665bc7;
  background: linear-gradient(145deg, #f7f5ff 0%, #e8e5fb 100%);
  border-color: rgba(255, 255, 255, 0.96);
  font-size: 24rpx;
  font-weight: 700;
}

.message-bubble {
  max-width: calc(100% - 78rpx);
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 25rpx;
  font-size: 25rpx;
  line-height: 1.68;
  word-break: break-word;
}

.message-bubble--guide {
  color: #3d5964;
  background: linear-gradient(145deg, rgba(246, 245, 255, 0.94), rgba(236, 245, 249, 0.9));
  border: 1rpx solid rgba(211, 217, 238, 0.84);
  border-bottom-left-radius: 9rpx;
}

.message-bubble--assistant {
  color: #173f50;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(235, 247, 249, 0.92));
  border: 1rpx solid rgba(198, 225, 231, 0.86);
  border-bottom-left-radius: 9rpx;
  box-shadow: 0 10rpx 26rpx rgba(49, 90, 105, 0.07);
}

.message-bubble--user {
  color: #ffffff;
  background: linear-gradient(135deg, #236b80 0%, #27758a 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-bottom-right-radius: 9rpx;
  box-shadow: 0 12rpx 28rpx rgba(35, 107, 128, 0.17);
}

.message-bubble__header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
  font-size: 21rpx;
  font-weight: 650;
  opacity: 0.88;
}

.degraded-badge {
  margin-left: 10rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #735729;
  background: #fff1cf;
  font-size: 21rpx;
}

.message-content {
  white-space: pre-wrap;
}

.used-context {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
  font-size: 21rpx;
}

.used-context__label {
  margin-right: 8rpx;
  color: #506b75;
}

.used-context__item {
  margin: 4rpx 8rpx 4rpx 0;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #236b80;
  background: rgba(255, 255, 255, 0.72);
}

.message-status {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 21rpx;
  text-align: right;
}

.message-failed {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 21rpx;
}

.retry-button {
  min-width: 124rpx;
  min-height: 88rpx;
  margin-left: 12rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  color: #ffffff;
}

.assistant-thinking {
  display: inline-flex;
  align-items: center;
  margin: 0 0 20rpx 78rpx;
  padding: 17rpx 22rpx;
  border: 1rpx solid rgba(198, 225, 231, 0.82);
  border-radius: 22rpx 22rpx 22rpx 8rpx;
  color: #506b75;
  background: rgba(249, 253, 254, 0.9);
  font-size: 21rpx;
}

.thinking-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #318ca6;
  animation: thinking 900ms ease-in-out infinite;
}

.thinking-dot:nth-child(2) {
  animation-delay: 150ms;
}

.thinking-dot:nth-child(3) {
  animation-delay: 300ms;
}

.assistant-thinking text {
  margin-left: 4rpx;
}

@keyframes thinking {
  0%, 100% {
    opacity: 0.38;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-5rpx);
  }
}

.status-message {
  display: block;
  margin: 12rpx 0 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  color: #963f38;
  background: #fff0ed;
  font-size: 21rpx;
  line-height: 1.5;
}

.chat-bottom {
  height: 2rpx;
}

.suggestion-section {
  margin-top: 24rpx;
}

.suggestion-list {
  display: flex;
  overflow-x: auto;
}

.suggestion-item {
  flex: 0 0 270rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(199, 221, 227, 0.9);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.76);
}

.suggestion-item + .suggestion-item {
  margin-left: 14rpx;
}

.suggestion-item__label {
  color: #236b80;
  font-size: 22rpx;
  font-weight: 650;
}

.suggestion-item__text {
  margin-top: 8rpx;
  color: #5d747d;
  font-size: 21rpx;
  line-height: 1.48;
}

.composer {
  position: sticky;
  bottom: 0;
  z-index: 4;
  margin-top: 22rpx;
  padding: 20rpx 20rpx 18rpx;
  padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.12);
  flex: none;
}

.message-input {
  width: 100%;
  min-height: 92rpx;
  max-height: 240rpx;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  color: #173f50;
  background: rgba(243, 249, 251, 0.84);
  border: 1rpx solid rgba(199, 221, 227, 0.9);
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.composer__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.input-count {
  color: #5d747d;
  font-size: 21rpx;
}

.send-button {
  min-width: 158rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #236b80 0%, #27758a 100%);
  font-size: 25rpx;
  font-weight: 650;
  box-shadow: 0 10rpx 24rpx rgba(35, 107, 128, 0.17);
  transition: opacity 140ms ease, transform 140ms ease;
}

.send-button--pressed {
  opacity: 0.86;
  transform: scale(0.985);
}

.chat-control--pressed {
  opacity: 0.76;
  transform: scale(0.985);
}

.send-button--disabled {
  opacity: 0.58;
  box-shadow: none;
}

.medical-disclaimer {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(215, 231, 235, 0.88);
  border-radius: 20rpx;
  color: #5d747d;
  background: rgba(239, 247, 249, 0.86);
  font-size: 21rpx;
  line-height: 1.65;
  flex: none;
}

.medical-disclaimer text + text {
  margin-top: 6rpx;
}

@media (prefers-reduced-motion: reduce) {
  .thinking-dot {
    animation: none;
  }

  .context-tab,
  .send-button {
    transition: none;
  }

  .send-button--pressed,
  .chat-control--pressed {
    transform: none;
  }
}
