page {
  min-height: 100%;
  background-color: #f4efff;
  background-image:
    radial-gradient(circle at 4% 2%, rgba(151, 127, 213, 0.18) 0, rgba(151, 127, 213, 0) 28%),
    radial-gradient(circle at 100% 20%, rgba(236, 157, 141, 0.14) 0, rgba(236, 157, 141, 0) 25%),
    linear-gradient(160deg, #fcfaff 0%, #f4efff 52%, #fff0ec 100%);
}

.register-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 32rpx 32rpx 58rpx;
  padding-bottom: calc(58rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(58rpx + env(safe-area-inset-bottom));
}

.ambient-orb {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
}

.ambient-orb--cyan {
  top: 20rpx;
  left: -180rpx;
  width: 430rpx;
  height: 430rpx;
  background: radial-gradient(circle, rgba(80, 190, 224, 0.13) 0, rgba(80, 190, 224, 0) 70%);
}

.ambient-orb--violet {
  top: 740rpx;
  right: -230rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(115, 103, 217, 0.07) 0, rgba(115, 103, 217, 0) 70%);
}

.register-header,
.register-form,
.back-login,
.medical-tip {
  position: relative;
  z-index: 1;
}

.register-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx 22rpx;
}

.register-brand-mark {
  width: 106rpx;
  height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 18rpx 48rpx rgba(49, 140, 166, 0.12);
}

.register-kicker {
  margin-top: 22rpx;
  color: #236b80;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.register-title {
  margin-top: 10rpx;
  color: #173f50;
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.3;
}

.register-subtitle {
  margin-top: 13rpx;
  color: #5d747d;
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
}

.register-form {
  margin-top: 26rpx;
}

.register-card {
  padding: 40rpx 34rpx 44rpx;
  background: rgba(255, 255, 255, 0.79);
  border-color: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 64rpx rgba(49, 90, 105, 0.09);
}

.register-card--first {
  border-radius: 36rpx 36rpx 12rpx 12rpx;
}

.register-card--last {
  margin-top: 3rpx;
  border-radius: 12rpx 12rpx 36rpx 36rpx;
}

.section-title {
  display: block;
  color: #173f50;
  font-size: 32rpx;
  font-weight: 700;
}

.section-description {
  display: block;
  margin-top: 9rpx;
  color: #5d747d;
  font-size: 23rpx;
  line-height: 1.6;
}

.field-block {
  margin-top: 32rpx;
}

.field-label {
  display: block;
  margin: 0 0 13rpx 3rpx;
  color: #244c5b;
  font-size: 25rpx;
  font-weight: 650;
}

.field-help {
  display: block;
  margin: -3rpx 0 16rpx 3rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-input {
  height: 92rpx;
  min-height: 92rpx;
  color: #173f50;
  background: rgba(248, 252, 253, 0.84);
  border-color: rgba(199, 221, 227, 0.9);
  border-radius: 22rpx;
  font-size: 27rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(35, 107, 128, 0.035);
}

.input-placeholder {
  color: #5d747d;
}

.choice-grid {
  display: flex;
  justify-content: space-between;
}

.choice-card {
  width: 48.5%;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(199, 221, 227, 0.92);
  border-radius: 23rpx;
  background: rgba(248, 252, 253, 0.72);
  transition: opacity 140ms ease, transform 140ms ease;
}

.choice-card--pressed {
  opacity: 0.78;
  transform: scale(0.985);
}

.choice-card--active {
  border-color: rgba(49, 140, 166, 0.82);
  background: linear-gradient(145deg, rgba(231, 247, 250, 0.94), rgba(241, 247, 255, 0.9));
  box-shadow: 0 10rpx 26rpx rgba(49, 140, 166, 0.1);
}

.choice-title,
.choice-description {
  display: block;
}

.choice-title {
  color: #173f50;
  font-size: 27rpx;
  font-weight: 650;
}

.choice-description {
  margin-top: 7rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.4;
}

.choice-card--active .choice-title {
  color: #236b80;
}

.gender-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
}

.gender-option {
  min-width: 136rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 7rpx;
  padding: 19rpx 20rpx;
  border: 1rpx solid rgba(199, 221, 227, 0.92);
  border-radius: 20rpx;
  color: #506b75;
  background: rgba(248, 252, 253, 0.72);
  font-size: 25rpx;
  text-align: center;
  transition: opacity 140ms ease, transform 140ms ease;
}

.gender-option--active {
  border-color: rgba(115, 103, 217, 0.58);
  color: #665bc7;
  background: rgba(241, 239, 255, 0.9);
  font-weight: 650;
}

.password-control {
  height: 92rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(199, 221, 227, 0.9);
  border-radius: 22rpx;
  background: rgba(248, 252, 253, 0.84);
  box-shadow: inset 0 2rpx 8rpx rgba(35, 107, 128, 0.035);
}

.password-input {
  flex: 1;
  min-width: 0;
  min-height: 90rpx;
  height: 90rpx;
  padding-left: 26rpx;
  color: #173f50;
  background: transparent;
  border: 0;
  border-radius: 0;
  font-size: 27rpx;
}

.visibility-button {
  flex-shrink: 0;
  min-width: 92rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  color: #236b80;
  font-size: 23rpx;
  font-weight: 650;
  transition: opacity 140ms ease;
}

.visibility-button--pressed,
.entry-link--pressed {
  opacity: 0.56;
}

.password-hint {
  display: block;
  margin-top: 11rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.55;
}

.consent-panel {
  margin-top: 28rpx;
  padding: 27rpx 28rpx;
  display: flex;
  align-items: flex-start;
  border: 1rpx solid rgba(197, 225, 231, 0.84);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(232, 247, 249, 0.86), rgba(244, 246, 255, 0.8));
}

.consent-checkbox-group,
.consent-checkbox-label {
  flex-shrink: 0;
}

.consent-copy {
  flex: 1;
  padding-top: 2rpx;
  color: #506b75;
  font-size: 24rpx;
  line-height: 1.7;
}

.consent-link {
  display: inline;
  color: #236b80;
  font-weight: 650;
}

.register-button {
  width: 100%;
  min-height: 94rpx;
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 23rpx;
  font-size: 29rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 16rpx 34rpx rgba(35, 107, 128, 0.2);
}

.back-login {
  display: block;
  min-height: 88rpx;
  margin-top: 24rpx;
  color: #236b80;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
  transition: opacity 140ms ease;
}

.register-form--locked .choice-card,
.register-form--locked .gender-option,
.register-form--locked .visibility-button,
.register-form--locked .consent-checkbox-group,
.register-form--locked .consent-link {
  pointer-events: none;
  opacity: 0.72;
}

.entry-link--disabled {
  pointer-events: none;
  opacity: 0.64;
}

.medical-tip {
  display: block;
  margin-top: 26rpx;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .choice-card,
  .gender-option,
  .visibility-button,
  .consent-link,
  .back-login {
    transition: none;
  }
}
