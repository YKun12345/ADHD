page {
  min-height: 100%;
  background: #f4f7fa;
}

.register-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.register-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.register-title {
  color: #17324d;
  font-size: 44rpx;
  font-weight: 700;
}

.register-subtitle {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 27rpx;
  line-height: 1.6;
  text-align: center;
}

.register-card {
  margin-top: 56rpx;
  padding: 40rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(23, 50, 77, 0.09);
}

.section-title {
  display: block;
  color: #17324d;
  font-size: 32rpx;
  font-weight: 700;
}

.section-description {
  display: block;
  margin-top: 20rpx;
  color: #718096;
  font-size: 27rpx;
}

.medical-tip {
  display: block;
  margin-top: auto;
  padding-top: 50rpx;
  text-align: center;
  color: #8795a3;
  font-size: 22rpx;
}