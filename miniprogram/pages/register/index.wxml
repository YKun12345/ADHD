<ai-copilot local-help-only="{{true}}" wx:if="{{!submitting}}" page-key="register" />
<ui-nav title="用户注册" fallbackUrl="/pages/login/index" />
<view class="register-page ui-page product-page">
  <view class="ambient-orb ambient-orb--cyan"></view>
  <view class="ambient-orb ambient-orb--violet"></view>
  <view class="register-header">
    <view class="register-brand-mark">
      <ui-icon name="scale" shape="sheet" label="用户注册资料" decorative="{{false}}" />
    </view>
    <text class="register-kicker">欢迎使用</text>
    <text class="register-title">创建用户账号</text>
    <text class="register-subtitle">
      建立本人或儿童档案，背景资料可以稍后填写
    </text>
  </view>

  <form class="register-form {{submitting ? 'register-form--locked' : ''}}" bindsubmit="handleSubmit">
    <view class="register-section register-section--first">
      <text class="section-title">使用者信息</text>
      <text class="section-description">
        请填写实际接受评估的本人或儿童资料
      </text>

      <view class="field-block">
        <text class="field-label">姓名</text>
        <input
          class="field-input ui-input"
          type="text"
          maxlength="100"
          disabled="{{submitting}}"
          value="{{fullName}}"
          placeholder="请输入本人或儿童姓名"
          placeholder-class="input-placeholder"
          data-field="fullName"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">为谁使用</text>
        <text class="field-help">选择实际使用方式，年龄用于核验适用范围</text>
        <view class="choice-grid patient-type-grid" aria-role="radiogroup" aria-label="使用者类型">
          <view
            class="choice-card {{patientType === 'adult' ? 'choice-card--active' : ''}}"
            data-value="adult"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{patientType === 'adult'}}"
            aria-disabled="{{submitting}}"
            bindtap="onPatientTypeSelect"
          >
            <text class="choice-title">本人使用</text>
            <text class="choice-description">成人量表与任务</text>
          </view>
          <view
            class="choice-card {{patientType === 'child' ? 'choice-card--active' : ''}}"
            data-value="child"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{patientType === 'child'}}"
            aria-disabled="{{submitting}}"
            bindtap="onPatientTypeSelect"
          >
            <text class="choice-title">为儿童使用</text>
            <text class="choice-description">儿童量表与任务</text>
          </view>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">年龄</text>
        <input
          class="field-input ui-input"
          type="number"
          maxlength="3"
          disabled="{{submitting}}"
          value="{{age}}"
          placeholder="请输入1至120之间的整数"
          placeholder-class="input-placeholder"
          data-field="age"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">性别（选填）</text>
        <view class="gender-grid" aria-role="radiogroup" aria-label="性别">
          <view
            class="gender-option {{gender === 'male' ? 'gender-option--active' : ''}}"
            data-value="male"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{gender === 'male'}}"
            aria-disabled="{{submitting}}"
            bindtap="onGenderSelect"
          >男</view>
          <view
            class="gender-option {{gender === 'female' ? 'gender-option--active' : ''}}"
            data-value="female"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{gender === 'female'}}"
            aria-disabled="{{submitting}}"
            bindtap="onGenderSelect"
          >女</view>
          <view
            class="gender-option {{gender === 'other' ? 'gender-option--active' : ''}}"
            data-value="other"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{gender === 'other'}}"
            aria-disabled="{{submitting}}"
            bindtap="onGenderSelect"
          >其他</view>
          <view
            class="gender-option {{gender === 'undisclosed' ? 'gender-option--active' : ''}}"
            data-value="undisclosed"
            hover-class="{{submitting ? 'none' : 'choice-card--pressed'}}"
            aria-role="radio"
            aria-checked="{{gender === 'undisclosed'}}"
            aria-disabled="{{submitting}}"
            bindtap="onGenderSelect"
          >不愿透露</view>
        </view>
      </view>
    </view>

    <view wx:if="{{patientType === 'child'}}" class="register-section">
      <text class="section-title">主要监护人</text>
      <text class="section-description">登录账号属于监护人，以上姓名和年龄属于儿童。确认监护关系后即可使用，一位主要监护人管理一名儿童。</text>
      <view class="field-block">
        <text class="field-label">监护人姓名</text>
        <input class="field-input ui-input" value="{{guardianName}}" maxlength="100" disabled="{{submitting}}" data-field="guardianName" bindinput="onFieldInput" placeholder="登录账号持有人的姓名" />
      </view>
      <view class="field-block">
        <text class="field-label">监护人年龄</text>
        <input class="field-input ui-input" type="number" value="{{guardianAge}}" maxlength="3" disabled="{{submitting}}" data-field="guardianAge" bindinput="onFieldInput" placeholder="18至120岁" />
      </view>
      <view class="choice-grid">
        <view class="choice-card {{guardianRelation === 'parent' ? 'choice-card--active' : ''}}" data-value="parent" bindtap="onGuardianRelationSelect"><text>父母</text></view>
        <view class="choice-card {{guardianRelation === 'legal_guardian' ? 'choice-card--active' : ''}}" data-value="legal_guardian" bindtap="onGuardianRelationSelect"><text>其他法定监护人</text></view>
      </view>
      <view class="field-block">
        <text class="field-label">监护关系说明（选填）</text>
        <input class="field-input ui-input" value="{{proofReference}}" maxlength="200" disabled="{{submitting}}" data-field="proofReference" bindinput="onFieldInput" placeholder="可以补充关系说明，无需机构编号或证件全文" />
      </view>
      <checkbox-group bindchange="onGuardianConfirmation"><label><checkbox value="guardian" checked="{{guardianConfirmed}}" disabled="{{submitting}}" />我确认是该儿童的主要监护人，对所填资料负责，并同意代儿童进行评估和日常记录；医生共享、外部AI和研究另行确认</label></checkbox-group>
    </view>

    <view class="register-section">
      <text class="section-title">账号安全</text>
      <text class="section-description">
        使用邮箱和安全密码创建账号
      </text>

      <view class="field-block">
        <text class="field-label">邮箱</text>
        <input
          class="field-input ui-input"
          type="text"
          maxlength="255"
          disabled="{{submitting}}"
          value="{{email}}"
          placeholder="例如 patient@example.com"
          placeholder-class="input-placeholder"
          data-field="email"
          bindinput="onFieldInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">密码</text>
        <view class="password-control">
          <input
            class="password-input ui-input"
            type="text"
            password="{{!showPassword}}"
            maxlength="128"
            disabled="{{submitting}}"
            value="{{password}}"
            placeholder="请输入密码"
            placeholder-class="input-placeholder"
            data-field="password"
            bindinput="onFieldInput"
          />
          <view
            class="visibility-button"
            hover-class="{{submitting ? 'none' : 'visibility-button--pressed'}}"
            aria-role="button"
            aria-disabled="{{submitting}}"
            bindtap="togglePasswordVisibility"
          >{{showPassword ? '隐藏' : '显示'}}</view>
        </view>
        <text class="password-hint">
          8至128位，不能为纯数字或常见弱密码
        </text>
      </view>

      <view class="field-block">
        <text class="field-label">确认密码</text>
        <view class="password-control">
          <input
            class="password-input ui-input"
            type="text"
            password="{{!showConfirmPassword}}"
            maxlength="128"
            disabled="{{submitting}}"
            value="{{confirmPassword}}"
            placeholder="请再次输入密码"
            placeholder-class="input-placeholder"
            data-field="confirmPassword"
            bindinput="onFieldInput"
          />
          <view
            class="visibility-button"
            hover-class="{{submitting ? 'none' : 'visibility-button--pressed'}}"
            aria-role="button"
            aria-disabled="{{submitting}}"
            bindtap="toggleConfirmPasswordVisibility"
          >{{showConfirmPassword ? '隐藏' : '显示'}}</view>
        </view>
      </view>
    </view>

    <view class="consent-panel">
      <checkbox-group
        class="consent-checkbox-group"
        bindchange="onConsentChange"
      >
        <label class="consent-checkbox-label">
          <checkbox
            value="agreed"
            checked="{{consentAgreed}}"
            disabled="{{submitting}}"
            color="#3f7c78"
          />
        </label>
      </checkbox-group>
      <view class="consent-copy">
        <text>我已阅读并同意</text>
        <view
          class="consent-link"
          hover-class="{{submitting ? 'none' : 'entry-link--pressed'}}"
          aria-role="button"
          aria-disabled="{{submitting}}"
          bindtap="showConsentSummary"
        >
          《知情同意说明摘要》
        </view>
      </view>
    </view>

    <button
      class="register-button ui-button ui-button--primary {{submitting ? 'ui-button--disabled' : ''}}"
      hover-class="ui-button--pressed"
      form-type="submit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      {{submitting ? '正在创建账号...' : '创建账号并登录'}}
    </button>
  </form>

  <view
    class="back-login {{submitting ? 'entry-link--disabled' : ''}}"
    hover-class="{{submitting ? 'none' : 'entry-link--pressed'}}"
    aria-role="button"
    aria-disabled="{{submitting}}"
    bindtap="goBackToLogin"
  >
    已有账号，返回登录
  </view>

  <text class="medical-tip">
    本平台仅用于辅助筛查，不替代专业医生诊断
  </text>
</view>
