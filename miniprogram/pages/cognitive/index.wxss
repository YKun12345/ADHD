page {
  min-height: 100%;
  background: linear-gradient(160deg, #f9fcfd 0%, #f1f8fa 58%, #edf5f7 100%);
}

.cognitive-page {
  min-height: 0;
  color: #17324d;
  background: transparent;
}

.cognitive-page--testing {
  background: #f5f8f9;
}

.cognitive-shell--testing {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f8f9;
}

.cognitive-shell--testing .cognitive-page {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.cognitive-shell--testing .cognitive-content {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.cognitive-shell--testing .test-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.cognitive-shell--testing .test-stage {
  flex: 1;
  min-height: 0;
}

.cognitive-content {
  box-sizing: border-box;
  padding: 42rpx 32rpx 54rpx;
  padding-bottom: calc(54rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.page-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.assessment-hero-icon {
  width: 124rpx;
  height: 104rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-kicker {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  color: #17324d;
  font-size: 42rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #5d747d;
  font-size: 24rpx;
}

.instruction-card,
.test-card,
.result-card {
  margin-top: 34rpx;
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.08);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.section-description {
  display: block;
  margin-top: 12rpx;
  color: #5d747d;
  font-size: 24rpx;
  line-height: 1.6;
}

.rule-list {
  margin-top: 28rpx;
}

.rule-item--go,
.rule-item--nogo {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
}

.rule-item--go {
  border-color: #b8ddd5;
  background: #edf8f5;
}

.rule-item--nogo {
  border-color: #f2c8c2;
  background: #fff3f1;
}

.rule-dot {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.rule-dot--go {
  background: #3f8b7f;
}

.rule-dot--nogo {
  background: #c85c52;
  border-radius: 16rpx;
}

.rule-copy {
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
}

.rule-title {
  font-size: 27rpx;
  font-weight: 700;
}

.rule-description {
  margin-top: 6rpx;
  color: #506b75;
  font-size: 23rpx;
}

.notice-box {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  color: #7a5b2b;
  background: #fff8e9;
  font-size: 23rpx;
  line-height: 1.6;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.primary-button {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #17324d;
}

.secondary-button {
  margin-top: 18rpx;
  display: flex;
  color: #17324d;
  background: #e8eef3;
}

.primary-button::after,
.secondary-button::after,
.pending-action::after,
.text-button::after {
  border: none;
}

.test-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.test-progress-label,
.test-progress-count {
  font-size: 25rpx;
  font-weight: 600;
}

.test-progress-count {
  color: #3f7c78;
}

.test-progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8ef;
}

.test-progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3f7c78, #73c7b6);
  transition: width 180ms ease;
}

.test-stage {
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  user-select: none;
}

.waiting-state,
.stimulus-state,
.feedback-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.waiting-ring {
  width: 118rpx;
  height: 118rpx;
  box-sizing: border-box;
  border: 12rpx solid #d8e0e7;
  border-top-color: #3f7c78;
  border-radius: 50%;
}

.waiting-label,
.feedback-text {
  margin-top: 28rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.waiting-help,
.stimulus-help,
.feedback-help {
  margin-top: 12rpx;
  color: #5d747d;
  font-size: 23rpx;
}

.stimulus-circle--go,
.stimulus-circle--nogo {
  width: 230rpx;
  height: 230rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 18rpx 42rpx rgba(23, 50, 77, 0.2);
}

.stimulus-circle--go {
  background: #3f8b7f;
}

.stimulus-circle--nogo {
  background: #c85c52;
  border-radius: 42rpx;
}

.stimulus-label {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
}

.feedback-icon,
.result-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-weight: 700;
}

.feedback-icon--correct::after,
.result-icon::after {
  content: '';
  width: 30rpx;
  height: 16rpx;
  margin-top: -7rpx;
  border-left: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(-45deg);
}

.feedback-icon--error::before,
.feedback-icon--error::after {
  content: '';
  position: absolute;
  width: 42rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: rotate(45deg);
}

.feedback-icon--error::after {
  transform: rotate(-45deg);
}

.feedback-icon {
  width: 108rpx;
  height: 108rpx;
  font-size: 46rpx;
}

.feedback-icon--correct {
  background: #3f8b7f;
}

.feedback-icon--error {
  background: #c58a43;
}

.result-heading {
  display: flex;
  align-items: center;
}

.result-icon {
  width: 82rpx;
  height: 82rpx;
  flex-shrink: 0;
  background: #3f7c78;
  font-size: 38rpx;
}

.result-heading-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 20rpx;
}

.result-title {
  font-size: 33rpx;
  font-weight: 700;
}

.sync-badge {
  margin-top: 8rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #2f6f6b;
  background: #e5f4f0;
  font-size: 21rpx;
}

.result-highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #17324d;
}

.result-highlight-label {
  color: #cfe4df;
  font-size: 23rpx;
}

.result-highlight-value {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.result-stat {
  width: 48%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 10rpx;
  border-radius: 18rpx;
  background: #f4f7fa;
  text-align: center;
}

.result-stat-value {
  font-size: 31rpx;
  font-weight: 700;
}

.result-stat-label {
  margin-top: 7rpx;
  color: #5d747d;
  font-size: 21rpx;
}

.error-summary {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #506b75;
  background: #fff8e9;
  font-size: 22rpx;
}

.text-button {
  margin-top: 16rpx;
  color: #3f7c78;
  background: transparent;
  font-size: 25rpx;
}

.pending-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  color: #7a5b2b;
  background: #fff8e9;
}

.pending-text {
  font-size: 23rpx;
}

.pending-action {
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #2f6f6b;
  background: transparent;
  font-size: 23rpx;
}

.cognitive-page--testing .page-heading,
.cognitive-page--testing .pending-banner,
.cognitive-page--testing .medical-tip {
  display: none;
}

.cognitive-page--testing .test-card {
  margin-top: 0;
  border-color: #e1e9ec;
  background: #ffffff;
  box-shadow: none;
}

.cognitive-page--testing .test-stage {
  background: #ffffff;
}

.cognitive-page--testing .test-progress-value {
  transition: none;
}

@media (prefers-reduced-motion: reduce) {
  .test-progress-value {
    transition: none;
  }
}

.medical-tip {
  display: block;
  margin-top: 34rpx;
  color: #5d747d;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.theme-lagoon {
  background:
    radial-gradient(circle at 12% 8%, rgba(115, 199, 182, 0.2) 0, rgba(115, 199, 182, 0) 30%),
    radial-gradient(circle at 92% 26%, rgba(80, 190, 224, 0.15) 0, rgba(80, 190, 224, 0) 28%),
    linear-gradient(160deg, #f7fdfb 0%, #eef8f7 56%, #edf6fa 100%);
}

.section-break-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 34rpx;
  padding: 42rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  text-align: center;
}

.section-break-card__mascot {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 38rpx 38rpx 46rpx 46rpx;
  background: linear-gradient(145deg, #8ad7c7, #3f8b7f);
  box-shadow: 0 16rpx 34rpx rgba(63, 139, 127, 0.2);
}

.section-break-card__spark {
  position: absolute;
  top: 32rpx;
  left: 38rpx;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.section-break-card__eyebrow { margin-top: 24rpx; color: #3f7c78; font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; }
.section-break-card__title { margin-top: 14rpx; font-size: 36rpx; font-weight: 750; }
.section-break-card__message { max-width: 520rpx; margin-top: 14rpx; color: #506b75; font-size: 24rpx; line-height: 1.7; }
.section-break-card__button { width: 100%; margin-top: 30rpx; }
