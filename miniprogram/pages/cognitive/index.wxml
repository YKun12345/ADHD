<task-instructions visible="{{instructionVisible}}" content="{{taskInstruction}}" remaining="{{instructionRemaining}}" ready="{{instructionReady}}" bindstart="handleInstructionStart" />
<ai-copilot wx:if="{{!instructionVisible && !submitting && (phase === 'intro' || phase === 'result')}}" page-key="cognitive" />
<view class="cognitive-shell {{phase === 'waiting' || phase === 'stimulus' || phase === 'feedback' ? 'cognitive-shell--testing' : ''}}">
<ui-nav title="Go / No-Go" />
<view class="cognitive-page theme-lagoon {{phase === 'intro' || phase === 'result' ? 'ai-copilot-safe-space' : ''}} {{phase === 'waiting' || phase === 'stimulus' || phase === 'feedback' ? 'cognitive-page--testing' : ''}}">
  <view class="cognitive-content">
    <view class="page-heading">
      <view class="assessment-hero-icon">
        <ui-icon name="gonogo" shape="pill" decorative="{{true}}" />
      </view>
      <text class="page-kicker">注意与抑制控制</text>
      <text class="page-title">Go / No-Go 认知测试</text>
      <text class="page-subtitle">共 {{totalTrials}} 个正式试次，请在安静环境中完成</text>
    </view>

    <view class="pending-banner" wx:if="{{phase === 'intro' && hasPendingResult}}">
      <text class="pending-text">上次结果尚未同步</text>
      <button
        class="pending-action"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步</button>
    </view>

    <view class="instruction-card glass-surface" wx:if="{{phase === 'intro'}}">
      <text class="section-title">测试说明</text>
      <text class="section-description">
        等待页面变色，按整个测试页面的颜色完成操作。
      </text>

      <view class="rule-list">
        <view class="rule-item rule-item--go">
          <view class="rule-dot rule-dot--go"></view>
          <view class="rule-copy">
            <text class="rule-title">GO · 需要反应</text>
            <text class="rule-description">看到绿色“点击”时请尽快点击</text>
          </view>
        </view>
        <view class="rule-item rule-item--nogo">
          <view class="rule-dot rule-dot--nogo"></view>
          <view class="rule-copy">
            <text class="rule-title">NO-GO · 保持抑制</text>
            <text class="rule-description">看到红色“停”时请保持不动</text>
          </view>
        </view>
      </view>

      <view class="notice-box">
        连续移动筛查版共 {{totalTrials}} 个试次，连续完成。提前点击也会记录为误触；结果不可与标准化临床工具直接等同。
      </view>
      <button class="primary-button ui-button ui-button--primary" hover-class="ui-button--pressed" bindtap="startTest">开始测试</button>
    </view>

    <view wx:elif="{{phase === 'waiting' || phase === 'stimulus' || phase === 'feedback'}}"
      class="test-stage full-screen-stimulus {{phase === 'stimulus' ? 'full-screen-stimulus--' + stimulusType : 'full-screen-stimulus--white'}}"
      aria-role="button" aria-label="{{phase === 'waiting' ? '白色等待页面，请勿点击' : phase === 'stimulus' && stimulusType === 'go' ? '绿色页面，请点击' : phase === 'stimulus' ? '红色页面，请勿点击' : '白色轮次间隔'}}"
      data-trial="{{currentTrialNumber}}" bindtap="handleTestTap">
      <view class="test-exit" catchtap="goBack" aria-role="button">退出测试</view>
      <view class="test-progress-header"><text>测试进度</text><text>{{currentTrialNumber}} / {{totalTrials}}</text></view>
      <view class="test-progress-track"><view class="test-progress-value" style="{{'width: ' + progressPercent + '%;'}}"></view></view>
      <view class="full-screen-prompt">
        <block wx:if="{{phase === 'stimulus'}}"><text class="stimulus-label">{{stimulusLabel}}</text><text class="stimulus-help">{{stimulusType === 'go' ? '点击测试页面' : '请勿点击，等待页面恢复白色'}}</text></block>
        <block wx:elif="{{phase === 'waiting'}}"><text class="waiting-label">等待变色</text><text class="waiting-help">此时请勿点击</text></block>
        <block wx:else><text class="feedback-text">{{feedbackText}}</text><text class="feedback-help">准备进入下一轮</text></block>
      </view>
    </view>

    <view class="result-card glass-surface" wx:elif="{{phase === 'result'}}">
      <view class="result-heading">
        <view class="result-icon" aria-hidden="true"></view>
        <view class="result-heading-copy">
          <text class="result-title">测试已完成</text>
          <text class="sync-badge sync-badge--{{syncStatus}}">{{syncStatus}}</text>
        </view>
      </view>

      <view class="result-highlight">
        <text class="result-highlight-label">总体正确率</text>
        <text class="result-highlight-value">{{result.accuracy}}%</text>
      </view>

      <view class="result-grid">
        <view class="result-stat">
          <text class="result-stat-value">{{result.average_reaction_time_ms}}</text>
          <text class="result-stat-label">平均反应时（毫秒）</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.go_accuracy}}%</text>
          <text class="result-stat-label">GO 正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.nogo_accuracy}}%</text>
          <text class="result-stat-label">NO-GO 正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.false_starts}}</text>
          <text class="result-stat-label">提前误触</text>
        </view>
      </view>

      <view class="error-summary">
        <text>冲动错误 {{result.commission_errors}} 次</text>
        <text>遗漏错误 {{result.omission_errors}} 次</text>
      </view>

      <button
        class="primary-button ui-button ui-button--primary {{submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{submitting ? 'none' : 'ui-button--pressed'}}"
        wx:if="{{syncStatus === '待同步'}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步结果</button>
      <button
        class="secondary-button ui-button ui-button--secondary {{submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{submitting ? 'none' : 'ui-button--pressed'}}"
        disabled="{{submitting}}"
        bindtap="restartTest"
      >再测一次</button>
      <button wx:if="{{mode === 'battery'}}" class="secondary-button ui-button ui-button--secondary" bindtap="goNext">继续完整评估</button>
      <button class="text-button ui-button" hover-class="ui-button--pressed" bindtap="goBack">返回患者首页</button>
    </view>

    <text class="medical-tip">
      本任务仅用于辅助筛查，不替代专业认知评估或医生诊断
    </text>
  </view>
</view>
</view>
