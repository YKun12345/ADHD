<ai-copilot wx:if="{{phase === 'intro' || phase === 'result'}}" page-key="stroop" />
<view class="stroop-shell {{phase === 'testing' || phase === 'feedback' ? 'stroop-shell--testing' : ''}}">
<ui-nav title="Stroop 测试" />
<view class="stroop-page {{phase === 'intro' || phase === 'result' ? 'ai-copilot-safe-space' : ''}} {{phase === 'testing' || phase === 'feedback' ? 'stroop-page--testing' : ''}}">
  <view class="stroop-content">
    <view class="page-heading">
      <view class="assessment-hero-icon">
        <ui-icon name="stroop" shape="lens" decorative="{{true}}" />
      </view>
      <text class="page-kicker">选择性注意与冲突抑制</text>
      <text class="page-title">Stroop 颜色词测试</text>
      <text class="page-subtitle">共 {{totalTrials}} 个正式试次，请准确且尽快作答</text>
    </view>

    <view class="pending-banner" wx:if="{{phase === 'intro' && hasPendingResult}}">
      <text>上次结果尚未同步</text>
      <button
        class="pending-action"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步</button>
    </view>

    <view class="instruction-card glass-surface" wx:if="{{phase === 'intro'}}">
      <text class="section-title">测试说明</text>
      <text class="instruction-text">
        判断文字的实际颜色，而不是文字本身的含义。
      </text>
      <view class="example-box">
        <text class="example-label">例如</text>
        <text class="example-word">红</text>
        <text class="example-answer">文字是“红”，实际颜色是蓝，应选择“蓝”</text>
      </view>
      <view class="notice-box">
        每题只能选择一次。请不要朗读文字，直接判断字体颜色。
      </view>
      <button class="primary-button ui-button ui-button--primary" hover-class="ui-button--pressed" bindtap="startTest">开始测试</button>
    </view>

    <view
      class="test-card glass-surface"
      wx:elif="{{phase === 'testing' || phase === 'feedback'}}"
    >
      <view class="progress-header">
        <text class="progress-label">测试进度</text>
        <text class="progress-count">{{currentTrialNumber}} / {{totalTrials}}</text>
      </view>
      <view class="progress-track">
        <view
          class="progress-value"
          style="{{'width: ' + progressPercent + '%;'}}"
        ></view>
      </view>

      <view class="prompt-area">
        <text class="prompt-help">请选择下面文字的实际颜色</text>
        <text
          class="stroop-word"
          style="{{'color: ' + currentColorHex + ';'}}"
        >{{currentWord}}</text>
      </view>

      <view class="feedback-panel {{feedbackCorrect ? 'feedback-panel--correct' : 'feedback-panel--error'}}" wx:if="{{phase === 'feedback'}}">
        <text class="feedback-text">{{feedbackText}}</text>
      </view>

      <view class="color-grid">
        <button
          class="color-button color-button--{{item.key}} {{phase !== 'testing' ? 'color-button--disabled' : ''}}"
          wx:for="{{colors}}"
          wx:key="key"
          data-key="{{item.key}}"
          hover-class="{{phase === 'testing' ? 'color-button--pressed' : 'none'}}"
          disabled="{{phase !== 'testing'}}"
          bindtap="handleAnswer"
        >
          <view class="color-swatch" style="{{'background: ' + item.hex + ';'}}"></view>
          <text>{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="result-card glass-surface" wx:elif="{{phase === 'result'}}">
      <view class="result-heading">
        <view class="result-icon" aria-hidden="true"></view>
        <view class="result-heading-copy">
          <text class="result-title">Stroop 测试已完成</text>
          <text class="sync-badge">{{syncStatus}}</text>
        </view>
      </view>

      <view class="result-highlight">
        <text class="result-highlight-label">总体正确率</text>
        <text class="result-highlight-value">{{result.accuracy}}%</text>
      </view>

      <view class="result-grid">
        <view class="result-stat">
          <text class="result-stat-value">{{result.median_reaction_time_ms}}</text>
          <text class="result-stat-label">中位反应时（毫秒）</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.congruent_accuracy}}%</text>
          <text class="result-stat-label">相容题正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.incongruent_accuracy}}%</text>
          <text class="result-stat-label">冲突题正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.interference_effect_ms}}</text>
          <text class="result-stat-label">干扰效应（毫秒）</text>
        </view>
      </view>

      <button
        class="primary-button ui-button ui-button--primary {{submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{submitting ? 'none' : 'ui-button--pressed'}}"
        wx:if="{{syncStatus === '待同步'}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步结果</button>
      <button
        class="secondary-button ui-button ui-button--secondary {{submitting ? 'ui-button--disabled' : ''}}"
        hover-class="{{submitting ? 'none' : 'ui-button--pressed'}}"
        disabled="{{submitting}}"
        bindtap="restartTest"
      >再测一次</button>
      <button wx:if="{{mode === 'battery'}}" class="secondary-button ui-button ui-button--secondary" bindtap="goNext">继续完整评估</button>
      <button class="text-button ui-button" hover-class="ui-button--pressed" bindtap="goBack">返回认知中心</button>
    </view>

    <text class="medical-tip">
      本任务仅用于辅助筛查，不替代专业认知评估或医生诊断
    </text>
  </view>
</view>
</view>
