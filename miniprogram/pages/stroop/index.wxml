<ai-copilot page-key="stroop" />
<view class="stroop-page">
  <view class="stroop-nav">
    <view class="nav-back" bindtap="goBack" aria-label="返回">‹</view>
    <text class="nav-title">Stroop 测试</text>
    <view class="nav-placeholder"></view>
  </view>

  <view class="stroop-content">
    <view class="page-heading">
      <text class="page-kicker">选择性注意与冲突抑制</text>
      <text class="page-title">Stroop 颜色词测试</text>
      <text class="page-subtitle">共 8 题，请准确且尽快作答</text>
    </view>

    <view class="pending-banner" wx:if="{{phase === 'intro' && hasPendingResult}}">
      <text>上次结果尚未同步</text>
      <button
        class="pending-action"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步</button>
    </view>

    <view class="instruction-card" wx:if="{{phase === 'intro'}}">
      <text class="section-title">测试说明</text>
      <text class="instruction-text">
        判断文字的实际颜色，而不是文字本身的含义。
      </text>
      <view class="example-box">
        <text class="example-label">例如</text>
        <text class="example-word">红</text>
        <text class="example-answer">文字是“红”，实际颜色是蓝，应选择“蓝”</text>
      </view>
      <view class="notice-box">
        每题只能选择一次。请不要朗读文字，直接判断字体颜色。
      </view>
      <button class="primary-button" bindtap="startTest">开始测试</button>
    </view>

    <view
      class="test-card"
      wx:elif="{{phase === 'testing' || phase === 'feedback'}}"
    >
      <view class="progress-header">
        <text class="progress-label">测试进度</text>
        <text class="progress-count">{{currentTrialNumber}} / {{totalTrials}}</text>
      </view>
      <view class="progress-track">
        <view
          class="progress-value"
          style="{{'width: ' + progressPercent + '%;'}}"
        ></view>
      </view>

      <view class="prompt-area">
        <text class="prompt-help">请选择下面文字的实际颜色</text>
        <text
          class="stroop-word"
          style="{{'color: ' + currentColorHex + ';'}}"
        >{{currentWord}}</text>
      </view>

      <view class="feedback-panel {{feedbackCorrect ? 'feedback-panel--correct' : 'feedback-panel--error'}}" wx:if="{{phase === 'feedback'}}">
        <text class="feedback-text">{{feedbackText}}</text>
      </view>

      <view class="color-grid">
        <button
          class="color-button color-button--{{item.key}}"
          wx:for="{{colors}}"
          wx:key="key"
          data-key="{{item.key}}"
          disabled="{{phase !== 'testing'}}"
          bindtap="handleAnswer"
        >
          <view class="color-swatch" style="{{'background: ' + item.hex + ';'}}"></view>
          <text>{{item.label}}</text>
        </button>
      </view>
    </view>

    <view class="result-card" wx:elif="{{phase === 'result'}}">
      <view class="result-heading">
        <view class="result-icon">✓</view>
        <view class="result-heading-copy">
          <text class="result-title">Stroop 测试已完成</text>
          <text class="sync-badge">{{syncStatus}}</text>
        </view>
      </view>

      <view class="result-highlight">
        <text class="result-highlight-label">总体正确率</text>
        <text class="result-highlight-value">{{result.accuracy}}%</text>
      </view>

      <view class="result-grid">
        <view class="result-stat">
          <text class="result-stat-value">{{result.average_reaction_time_ms}}</text>
          <text class="result-stat-label">平均反应时（毫秒）</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.congruent_accuracy}}%</text>
          <text class="result-stat-label">相容题正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.incongruent_accuracy}}%</text>
          <text class="result-stat-label">冲突题正确率</text>
        </view>
        <view class="result-stat">
          <text class="result-stat-value">{{result.correct}} / {{result.wrong}}</text>
          <text class="result-stat-label">正确 / 错误</text>
        </view>
      </view>

      <button
        class="primary-button"
        wx:if="{{syncStatus === '待同步'}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="retrySync"
      >重新同步结果</button>
      <button
        class="secondary-button"
        disabled="{{submitting}}"
        bindtap="restartTest"
      >再测一次</button>
      <button class="text-button" bindtap="goBack">返回认知中心</button>
    </view>

    <text class="medical-tip">
      本任务仅用于辅助筛查，不替代专业认知评估或医生诊断
    </text>
  </view>
</view>
