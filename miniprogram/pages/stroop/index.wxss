page {
  min-height: 100%;
  background: linear-gradient(160deg, #f9fcfd 0%, #f1f8fa 58%, #edf5f7 100%);
}

.stroop-page {
  min-height: 0;
  color: #17324d;
  background: transparent;
}

.stroop-page--testing {
  background: #f5f8f9;
}

.stroop-shell--testing {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f8f9;
}

.stroop-shell--testing .stroop-page {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.stroop-shell--testing .stroop-content {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.stroop-shell--testing .test-card {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.stroop-shell--testing .prompt-area {
  flex: 1;
  min-height: 0;
}

.stroop-content {
  box-sizing: border-box;
  padding: 42rpx 32rpx 54rpx;
  padding-bottom: calc(54rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.page-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.assessment-hero-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-kicker {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #5d747d;
  font-size: 24rpx;
}

.instruction-card,
.test-card,
.result-card {
  margin-top: 34rpx;
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 18rpx 48rpx rgba(49, 90, 105, 0.08);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.instruction-text {
  display: block;
  margin-top: 14rpx;
  color: #506b75;
  font-size: 25rpx;
  line-height: 1.6;
}

.example-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f4f7fa;
}

.example-label {
  color: #5d747d;
  font-size: 22rpx;
}

.example-word {
  margin-top: 12rpx;
  color: #3976b8;
  font-size: 72rpx;
  font-weight: 800;
}

.example-answer {
  margin-top: 12rpx;
  color: #526575;
  font-size: 22rpx;
  text-align: center;
}

.notice-box {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #7a5b2b;
  background: #fff8e9;
  font-size: 22rpx;
  line-height: 1.6;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.primary-button {
  margin-top: 30rpx;
  color: #ffffff;
  background: #17324d;
}

.secondary-button {
  margin-top: 18rpx;
  color: #17324d;
  background: #e8eef3;
}

.primary-button::after,
.secondary-button::after,
.color-button::after,
.pending-action::after,
.text-button::after {
  border: none;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 600;
}

.progress-count {
  color: #3f7c78;
}

.progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8ef;
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3f7c78, #73c7b6);
  transition: width 180ms ease;
}

.prompt-area {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.prompt-help {
  color: #5d747d;
  font-size: 23rpx;
}

.stroop-word {
  margin-top: 28rpx;
  font-size: 116rpx;
  font-weight: 800;
  line-height: 1.2;
}

.feedback-panel {
  margin-bottom: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  text-align: center;
}

.feedback-panel--correct {
  color: #2f6f6b;
  background: #edf8f5;
}

.feedback-panel--error {
  color: #9b4b43;
  background: #fff3f1;
}

.feedback-text {
  font-size: 24rpx;
  font-weight: 600;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.color-button {
  width: 48%;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  border: 2rpx solid #dce5ec;
  border-radius: 18rpx;
  color: #17324d;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.color-button--disabled {
  opacity: 0.55;
}

.color-button--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.color-swatch {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.result-heading {
  display: flex;
  align-items: center;
}

.result-icon {
  position: relative;
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #3f7c78;
  font-size: 38rpx;
  font-weight: 700;
}

.result-icon::after {
  content: '';
  width: 30rpx;
  height: 16rpx;
  margin-top: -7rpx;
  border-left: 6rpx solid #ffffff;
  border-bottom: 6rpx solid #ffffff;
  transform: rotate(-45deg);
}

.result-heading-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sync-badge {
  margin-top: 8rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #2f6f6b;
  background: #e5f4f0;
  font-size: 21rpx;
}

.result-highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #17324d;
}

.result-highlight-label {
  color: #cfe4df;
  font-size: 23rpx;
}

.result-highlight-value {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.result-stat {
  width: 48%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 10rpx;
  border-radius: 18rpx;
  background: #f4f7fa;
  text-align: center;
}

.result-stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.result-stat-label {
  margin-top: 7rpx;
  color: #5d747d;
  font-size: 21rpx;
}

.text-button {
  margin-top: 16rpx;
  color: #3f7c78;
  background: transparent;
  font-size: 25rpx;
}

.pending-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  color: #7a5b2b;
  background: #fff8e9;
  font-size: 23rpx;
}

.pending-action {
  min-height: 88rpx;
  margin: 0;
  color: #2f6f6b;
  background: transparent;
  font-size: 23rpx;
}

.stroop-page--testing .page-heading,
.stroop-page--testing .pending-banner,
.stroop-page--testing .medical-tip {
  display: none;
}

.stroop-page--testing .test-card {
  margin-top: 0;
  border-color: #e1e9ec;
  background: #ffffff;
  box-shadow: none;
}

.stroop-page--testing .progress-value,
.stroop-page--testing .color-button {
  transition: none;
}

@media (prefers-reduced-motion: reduce) {
  .progress-value,
  .color-button {
    transition: none;
  }
}

.medical-tip {
  display: block;
  margin-top: 34rpx;
  color: #5d747d;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

.theme-spectrum {
  background:
    radial-gradient(circle at 8% 10%, rgba(233, 161, 149, 0.16) 0, rgba(233, 161, 149, 0) 28%),
    radial-gradient(circle at 94% 18%, rgba(168, 156, 229, 0.16) 0, rgba(168, 156, 229, 0) 30%),
    linear-gradient(160deg, #fffaf9 0%, #f8f6fc 52%, #eef7fb 100%);
}

.section-break-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 34rpx;
  padding: 42rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.88);
  text-align: center;
}

.section-break-card__mascot {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: conic-gradient(from 30deg, #e9a195, #f1cc7a, #8ac8b7, #86aee2, #a89ce5, #e9a195);
  box-shadow: 0 16rpx 34rpx rgba(115, 103, 217, 0.16);
}

.section-break-card__spark {
  position: absolute;
  top: 38rpx;
  left: 38rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
}

.section-break-card__eyebrow { margin-top: 24rpx; color: #7869bd; font-size: 22rpx; font-weight: 650; letter-spacing: 2rpx; }
.section-break-card__title { margin-top: 14rpx; font-size: 36rpx; font-weight: 750; }
.section-break-card__message { max-width: 520rpx; margin-top: 14rpx; color: #526575; font-size: 24rpx; line-height: 1.7; }
.section-break-card__button { width: 100%; margin-top: 30rpx; }
