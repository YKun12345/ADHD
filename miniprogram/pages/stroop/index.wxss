page {
  min-height: 100%;
  background: #f4f7fa;
}

.stroop-page {
  min-height: 100vh;
  color: #17324d;
  background: #f4f7fa;
}

.stroop-nav {
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  color: #ffffff;
  background: #17324d;
}

.nav-back,
.nav-placeholder {
  width: 68rpx;
  height: 68rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 62rpx;
  line-height: 1;
}

.nav-title {
  font-size: 29rpx;
  font-weight: 500;
}

.stroop-content {
  box-sizing: border-box;
  padding: 46rpx 32rpx calc(54rpx + env(safe-area-inset-bottom));
}

.page-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.page-kicker {
  color: #3f7c78;
  font-size: 23rpx;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 14rpx;
  color: #718096;
  font-size: 24rpx;
}

.instruction-card,
.test-card,
.result-card {
  margin-top: 34rpx;
  box-sizing: border-box;
  padding: 36rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(23, 50, 77, 0.09);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.instruction-text {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.6;
}

.example-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f4f7fa;
}

.example-label {
  color: #718096;
  font-size: 22rpx;
}

.example-word {
  margin-top: 12rpx;
  color: #3976b8;
  font-size: 72rpx;
  font-weight: 800;
}

.example-answer {
  margin-top: 12rpx;
  color: #526575;
  font-size: 22rpx;
  text-align: center;
}

.notice-box {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #7a5b2b;
  background: #fff8e9;
  font-size: 22rpx;
  line-height: 1.6;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.primary-button {
  margin-top: 30rpx;
  color: #ffffff;
  background: #17324d;
}

.secondary-button {
  margin-top: 18rpx;
  color: #17324d;
  background: #e8eef3;
}

.primary-button::after,
.secondary-button::after,
.color-button::after,
.pending-action::after,
.text-button::after {
  border: none;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 600;
}

.progress-count {
  color: #3f7c78;
}

.progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e2e8ef;
}

.progress-value {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3f7c78, #73c7b6);
  transition: width 180ms ease;
}

.prompt-area {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.prompt-help {
  color: #718096;
  font-size: 23rpx;
}

.stroop-word {
  margin-top: 28rpx;
  font-size: 116rpx;
  font-weight: 800;
  line-height: 1.2;
}

.feedback-panel {
  margin-bottom: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  text-align: center;
}

.feedback-panel--correct {
  color: #2f6f6b;
  background: #edf8f5;
}

.feedback-panel--error {
  color: #9b4b43;
  background: #fff3f1;
}

.feedback-text {
  font-size: 24rpx;
  font-weight: 600;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.color-button {
  width: 48%;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  border: 2rpx solid #dce5ec;
  border-radius: 18rpx;
  color: #17324d;
  background: #f7f9fb;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.color-button[disabled] {
  opacity: 0.55;
}

.color-swatch {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.result-heading {
  display: flex;
  align-items: center;
}

.result-icon {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #3f7c78;
  font-size: 38rpx;
  font-weight: 700;
}

.result-heading-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sync-badge {
  margin-top: 8rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  color: #2f6f6b;
  background: #e5f4f0;
  font-size: 21rpx;
}

.result-highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #17324d;
}

.result-highlight-label {
  color: #cfe4df;
  font-size: 23rpx;
}

.result-highlight-value {
  margin-top: 6rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.result-stat {
  width: 48%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 10rpx;
  border-radius: 18rpx;
  background: #f4f7fa;
  text-align: center;
}

.result-stat-value {
  font-size: 30rpx;
  font-weight: 700;
}

.result-stat-label {
  margin-top: 7rpx;
  color: #718096;
  font-size: 20rpx;
}

.text-button {
  margin-top: 16rpx;
  color: #3f7c78;
  background: transparent;
  font-size: 25rpx;
}

.pending-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  color: #7a5b2b;
  background: #fff8e9;
  font-size: 23rpx;
}

.pending-action {
  margin: 0;
  color: #2f6f6b;
  background: transparent;
  font-size: 23rpx;
}

.medical-tip {
  display: block;
  margin-top: 34rpx;
  color: #8795a3;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
