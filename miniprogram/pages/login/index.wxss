page {
  min-height: 100%;
  background-color: #eaf6ff;
  background-image:
    radial-gradient(circle at 6% 4%, rgba(79, 177, 224, 0.2) 0, rgba(79, 177, 224, 0) 34%),
    radial-gradient(circle at 100% 32%, rgba(235, 170, 129, 0.15) 0, rgba(235, 170, 129, 0) 30%),
    linear-gradient(158deg, #fbfdff 0%, #eaf6ff 58%, #fff3ea 100%);
}

.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 112rpx 40rpx 54rpx;
  padding-top: calc(72rpx + constant(safe-area-inset-top));
  padding-top: calc(72rpx + env(safe-area-inset-top));
  padding-bottom: calc(54rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.ambient-orb {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
}

.ambient-orb--cyan {
  top: 30rpx;
  left: -150rpx;
  width: 390rpx;
  height: 390rpx;
  background: radial-gradient(circle, rgba(80, 190, 224, 0.14) 0, rgba(80, 190, 224, 0) 70%);
}

.ambient-orb--violet {
  top: 430rpx;
  right: -190rpx;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(115, 103, 217, 0.08) 0, rgba(115, 103, 217, 0) 70%);
}

.login-header,
.login-card,
.disclaimer {
  position: relative;
  z-index: 1;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-kicker {
  margin-top: 0;
  color: #236b80;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.title {
  margin-top: 12rpx;
  color: #173f50;
  font-size: 50rpx;
  font-weight: 750;
  line-height: 1.25;
  letter-spacing: 2rpx;
}

.subtitle {
  margin-top: 14rpx;
  color: #5d747d;
  font-size: 26rpx;
  line-height: 1.6;
}

.login-card {
  margin-top: 54rpx;
  padding: 42rpx 36rpx 34rpx;
  background: rgba(255, 255, 255, 0.8);
  border-color: rgba(255, 255, 255, 0.96);
  border-radius: 36rpx;
  box-shadow:
    0 28rpx 70rpx rgba(49, 90, 105, 0.11),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.card-intro {
  display: flex;
  flex-direction: column;
  margin-bottom: 34rpx;
}

.card-title {
  color: #173f50;
  font-size: 34rpx;
  font-weight: 700;
}

.card-subtitle {
  margin-top: 9rpx;
  color: #5d747d;
  font-size: 23rpx;
  line-height: 1.5;
}

.role-selector {
  display: flex;
  gap: 16rpx;
  margin: 0 0 32rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(199, 221, 227, 0.82);
  border-radius: 24rpx;
  background: rgba(239, 247, 249, 0.72);
}

.role-option {
  flex: 1;
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  color: #5d747d;
}

.role-option--active {
  border-color: rgba(55, 116, 158, 0.26);
  color: #174d6a;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(35, 107, 128, 0.1);
}

.role-title {
  font-size: 27rpx;
  font-weight: 700;
}

.role-note {
  margin-top: 5rpx;
  font-size: 21rpx;
}

.field-label {
  display: block;
  margin: 0 0 14rpx 4rpx;
  color: #244c5b;
  font-size: 25rpx;
  font-weight: 650;
}

.password-label {
  margin-top: 28rpx;
}

.field-input {
  height: 94rpx;
  min-height: 94rpx;
  padding: 0 28rpx;
  color: #173f50;
  background: rgba(248, 252, 253, 0.82);
  border-color: rgba(199, 221, 227, 0.9);
  border-radius: 22rpx;
  font-size: 28rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(35, 107, 128, 0.035);
}

.input-placeholder {
  color: #5d747d;
}

.login-button {
  width: 100%;
  min-height: 94rpx;
  margin-top: 40rpx;
  border-radius: 23rpx;
  font-size: 30rpx;
  letter-spacing: 3rpx;
  box-shadow: 0 16rpx 34rpx rgba(35, 107, 128, 0.2);
}

.login-tip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  text-align: center;
}

.entry-link {
  color: #236b80;
  font-size: 24rpx;
  font-weight: 600;
  transition: opacity 140ms ease;
}

.entry-link--pressed {
  opacity: 0.56;
}

.entry-link--disabled {
  pointer-events: none;
  opacity: 0.64;
}

.soft-divider {
  height: 1rpx;
  margin: 30rpx 0 8rpx;
  background: linear-gradient(90deg, rgba(215, 231, 235, 0), #d7e7eb, rgba(215, 231, 235, 0));
}

.server-entry {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5d747d;
  font-weight: 500;
}

.disclaimer {
  margin-top: auto;
  padding: 42rpx 22rpx 0;
  color: #5d747d;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .entry-link {
    transition: none;
  }
}
